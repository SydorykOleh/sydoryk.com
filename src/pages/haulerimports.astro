---
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import {pageTag, pageDescription,experienceTdk} from '../data/content';
---

<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>

<BlogPostLayout
	title={experienceTdk.title || ''}
	description = {experienceTdk.description || ''}
	keywords = {experienceTdk.keywords || ''}
>


	<div class="post">
		<main class="post-wrapper about">
			<section class="border-top" style="padding-top: 2rem;">
				<div class="content">
					<div class="demo">
					Quick example. Change colors:
					<model-viewer id="color" alt="test" src="/assets/3d/test.glb" ar environment-image="/assets/3d/lightroom_14b.hdr"  shadow-intensity="1" camera-controls touch-action="pan-y" interaction-prompt="none" >
						<div class="controls glass" id="color-controls">
							<button data-color="#3F1919">Red</button>
							<button data-color="#193F1D">Green</button>
							<button data-color="#192A3F">Blue</button>
                  		</div>
					</model-viewer>
					</div>
				</div>
			</section>
		</main>
	</div>
</BlogPostLayout>

<script>
	const modelViewerColor = document.querySelector("model-viewer#color");

	document.querySelector('#color-controls').addEventListener('click', (event) => {
	const colorString = event.target.dataset.color;
	const [material] = modelViewerColor.model.materials;
	material.pbrMetallicRoughness.setBaseColorFactor(colorString);
	});
</script>

<style>
	.demo {
		height: 75vh;
	}
	.demo model-viewer {
		width: 100%;
		height: 100%;
	}
	.about {
		display: flex;
		flex-direction: column;
		margin:0 auto;
	}
	p{
		margin:0.75rem 0;
	}
	figure{
		margin:2rem 0;
	}
	img{max-width: 100%;}
	.portrait{
		border-radius: 100px;
		margin:12px 0 12px;
		overflow: hidden;
		text-align: left;
	}
	a, a:link{
		color:var(--color-blue);
	}
</style>
