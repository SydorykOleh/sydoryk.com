---
import { type CollectionEntry, getCollection } from 'astro:content';
import ProposalLayout from '../layouts/ProposalLayout.astro';

interface Props {
	entry: CollectionEntry<'coverletter'>;
}

export async function getStaticPaths() {
	const coverletters = await getCollection('coverletter');
	return coverletters.map((entry) => ({
		params: { slug: `coverletter/${entry.slug}` },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<ProposalLayout 
	title={entry.data.title} 
	company={entry.data.company}
	role={entry.data.role}
	description={`Job Cover Letter for ${entry.data.company}`}
>
	<Content />
</ProposalLayout>
