---

<BaseLayout
	title="Co-op Operations Dossier // Cossack & Gentleman"
	description="Comprehensive 50-title co-op recommendations, game update audit, and balanced library comparison with Ukrainian pricing."
>
	<div class="coop-page">
		<!-- HERO SECTION -->
		<header class="coop-hero">
			<div class="container">
				<div class="badge-row">
					<span class="pill pill-primary">Strategic Dossier</span>
					<span class="pill">Cossack × Gentleman</span>
					<span class="pill pill-accent">50-Game Catalog</span>
					<span class="pill pill-currency">Steam UA (₴)</span>
				</div>
				<h1 class="hero-title">Co-op Gaming Operations</h1>
				<p class="hero-subtitle">
					Balanced across <strong>Gentleman's survival & simulation library</strong> (166 games) and <strong>Cossack's automation & tactical history</strong>. Every game is directly linked to Steam with verified Ukrainian pricing (₴).
				</p>
			</div>
		</header>

		<main class="container">
			<!-- SYMMETRY PROFILE -->
			<section class="section-block">
				<div class="symmetry-box">
					<div class="sym-col">
						<h3>Cossack's Core Anchors</h3>
						<ul class="sym-list">
							<li><strong>Factorio (1,737h)</strong> & <strong>Eco (112h)</strong>: Deep industrial logistics, power grids & automation.</li>
							<li><strong>Dota 2 (6.9k h)</strong> & <strong>Deadlock (325h)</strong>: Competitive high-stress team coordination.</li>
							<li><strong>Path of Exile (180h)</strong> & <strong>Enshrouded (101h)</strong>: ARPG progression, loot tiers & voxel construction.</li>
						</ul>
					</div>
					<div class="sym-divider">
						<span class="vs-badge">×</span>
					</div>
					<div class="sym-col">
						<h3>Gentleman's Core Anchors</h3>
						<ul class="sym-list">
							<li><strong>The Forest, Green Hell & ICARUS</strong>: Hardcore atmospheric survival, shelter building & environmental hazards.</li>
							<li><strong>Frostpunk (Badge) & Wall World</strong>: Resource crisis management, wall mining & turret defense.</li>
							<li><strong>Motor Town, BeamNG & NFS</strong>: Strong interest in physics driving, logistics & vehicle customization.</li>
						</ul>
					</div>
				</div>
				<div class="sweetspot-banner">
					<strong>🎯 The Joint Sweet Spot:</strong> High-agency co-op survival with base engineering, electrical/power grids, emergent vehicle physics, and tactical combat that supports multi-week check-ins.
				</div>
			</section>

			<!-- WHAT'S NEW AUDIT -->
			<section class="section-block">
				<div class="section-header">
					<h2>🔄 What's New Since We Last Played</h2>
					<p>Major expansions and 1.0 launches in games you already own in your library (0 ₴ extra cost):</p>
				</div>

				<div class="revisit-grid">
					{revisits.map((item) => (
						<article class="revisit-card">
							<div class="revisit-top">
								<h3 class="revisit-title">
									<a
										href={`https://store.steampowered.com/app/${item.appid}/`}
										target="_blank"
										rel="noopener noreferrer"
										class="title-link"
									>
										{item.title} ↗
									</a>
								</h3>
								<span class="revisit-status">{item.status}</span>
							</div>
							<span class="last-played-tag">Last active: {item.lastPlayed}</span>

							<ul class="update-list">
								{item.majorUpdates.map((up) => (
									<li>{up}</li>
								))}
							</ul>

							<div class="verdict-bar">
								<strong>Verdict:</strong> {item.verdict}
							</div>
						</article>
					))}
				</div>
			</section>

			<!-- TOP 4 SLATE -->
			<section class="section-block">
				<div class="section-header">
					<h2>⭐ Top 4 Fresh Recommendations</h2>
					<p>Unplayed by both players, zero spoilers, budget-friendly in Hryvnias (₴), and engineered for weekend co-op:</p>
				</div>

				<div class="rec-grid">
					{topRecs.map((game) => (
						<article class="rec-card">
							<div class="rec-top">
								<span class="rec-rank">{game.rank}</span>
								<span class="pill pill-accent">{game.tag}</span>
								<span class="rec-price">{game.price}</span>
							</div>

							<h3 class="rec-title">
								<a
									href={game.steamUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="title-link"
								>
									{game.title} ↗
								</a>
							</h3>
							<p class="rec-tagline">{game.tagline}</p>

							<div class="rec-body">
								<h4 class="subhead">Operational Highlights:</h4>
								<ul class="feature-list">
									{game.features.map((feat) => (
										<li>{feat}</li>
									))}
								</ul>

								<div class="why-box">
									<strong>Why it fits our chemistry:</strong> {game.whyYou}
								</div>
							</div>

							<div class="rec-footer">
								<span class="rating-badge">★ {game.rating}</span>
								<a
									href={game.steamUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="btn-steam"
								>
