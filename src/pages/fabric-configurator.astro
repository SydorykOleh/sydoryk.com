---
// SYSTEM NOTE: See `docs/fabric-viewer-workflow.md` for architecture, workflows, and rules regarding the fabric configurator.

import ConfiguratorLayout from '../layouts/ConfiguratorLayout.astro';
import fs from 'fs';
import path from 'path';

const title = "3D Fabric Configurator | Sydoryk Oleh";
const description = "Interactive 3D configurator for premium fabric textures with real-time sheen and PBR rendering.";

// Read manifest
const manifestPath = path.join(process.cwd(), 'public/assets/configurator/manifest.json');
let manifest = { batches: [], collections: [], textures: [] };
try {
    if (fs.existsSync(manifestPath)) {
        manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf-8'));
    }
} catch (e) {
    console.error("Error parsing manifest:", e);
}

const SHOW_DEBUG_CONTROLS = true;
---

<ConfiguratorLayout title={title} description={description} fullWidth={true}>
    <div class="configurator-full-layout">
        <div class="viewer-column">
        <!-- Canvas Area (Split) -->
        <div class="viewer-split">
            <!-- 3D Canvas -->
            <div class="viewer-3d">
                <div class="viewer-overlay-controls">
                    <div class="overlay-group angle-controls-group">
                        <span class="overlay-label" style="display: none;">Angle</span>
                        <div class="button-group angle-selectors" id="angle-selectors">
                            <button class="active" data-angle="0">Light 1</button>
                            <button data-angle="1">Light 2</button>
                            <button data-angle="2">Light 3</button>
                        </div>
                    </div>
                    <div class="overlay-group">
                        <span class="overlay-label">Lighting</span>
                        <div class="button-group mode-toggles">
                            <button class="mode-btn active" data-mode="baked">baked</button>
                            <button class="mode-btn" data-mode="normal">default</button>
                        </div>
                    </div>
                    <div class="overlay-group">
                        <span class="overlay-label">Material</span>
                        <div class="button-group material-toggles" id="material-toggles">
                            <button class="material-btn active" data-material="default">Fabric</button>
                            <button class="material-btn" data-material="velvet">Velvet</button>
                        </div>
                    </div>
                    <div class="overlay-group camera-group">
                        <span class="overlay-label" style="display: none;">Camera</span>
                        <button class="reset-camera-btn" id="reset-camera-btn">Reset Camera</button>
                    </div>
                </div>
                <div class="viewer-overlay-bottom-left">
                    <!-- <div class="slider-container velvet-slider">
                        <span class="slider-label">Detail Str</span>
                        <input type="range" id="sheen-normal-strength-slider" min="0" max="5" step="0.1" value="0.7" />
                        <span id="sheen-normal-strength-value">0.70</span>
                    </div> -->
                    <div class="slider-container">
                        <span class="slider-label">Scale</span>
                        <input type="range" id="texture-scale-slider" min="1" max="20" step="0.5" value="12" />
                        <span id="texture-scale-value">12.0</span>
                    </div>
                </div>
                <div id="three-container"></div>
                <div class="loading-overlay" id="loading-overlay">
                    <div class="spinner"></div>
                    <span>Loading Assets...</span>
                </div>
            </div>

            <!-- Render Preview -->
            <!-- <div class="viewer-render">
                <div class="render-image-container">
                    <img id="render-image" src="" alt="Render Preview" />
                    <div class="empty-state" id="render-empty">
                        <span>No render available</span>
                    </div>
                </div>
            </div> -->
        </div>

        <!-- CC Preview Container -->
        <div class="cc-preview-container" id="cc-preview-container" style="display: none;">
            <img id="cc-preview-image" src="" alt="Color Correction Preview" />
            <div class="empty-state" id="cc-preview-empty" style="display: none;">
                <span>No CC preview available</span>
            </div>
        </div>
        </div>

        <div class="controls-column">
        <!-- Top Controls -->
        <div class="top-controls">

            
            <div class="control-group">
                <h3>Batch</h3>
                <div class="collection-buttons" id="batch-buttons">
                    {manifest.batches.map(batch => (
                        <button class="collection-btn batch-btn" data-batch={batch}>{batch}</button>
                    ))}
                </div>
            </div>

            <div class="control-group" id="collections-group" style="display: none;">
                <h3>Collection</h3>
                <div class="collection-buttons" id="collection-buttons">
                    {manifest.collections.map(col => (
                        <button class="collection-btn col-btn" data-collection={col} style="display: none;">{col}</button>
                    ))}
                </div>
            </div>

            <div class="control-group">
                <h3>Select Texture</h3>
                <div class="texture-grid" id="texture-grid">
                    {manifest.textures.map(tex => (
                        <button 
                            class="texture-btn" 
                            data-id={tex.id} 
                            data-batch={tex.batch}
                            data-collection={tex.collection}
                            data-renders={tex.renders ? tex.renders.join(',') : ''}
                            title={tex.name}
                        >
                            <img src={`/assets/configurator/textures/${tex.id}_2k/color.webp`} alt={tex.name} />
                            <div class="tex-info">
                                <span class="tex-code">{tex.id}</span>
                                <span class="tex-name">{tex.name}</span>
                            </div>
                        </button>
                    ))}
                </div>
            </div>

            {SHOW_DEBUG_CONTROLS && (
                <details class="debug-panel" id="debug-panel" style="display: none;">
                    <summary>Debug Controls</summary>
                    <div class="controls-row secondary-controls compact-controls">
                        <div class="control-group" data-mode="baked">
                            <h3>Texture Blend</h3>
                            <div class="slider-container">
                                <input type="range" id="texture-blend-slider" min="0" max="2" step="0.01" value="1.0" />
                                <span id="texture-blend-value">1.00</span>
                            </div>
                        </div>

                        <div class="control-group" data-mode="baked">
                            <h3>LM Gain</h3>
                            <div class="slider-container">
                                <input type="range" id="lm-gain-slider" min="0" max="2" step="0.05" value="1.0" />
                                <span id="lm-gain-value">1.00</span>
                            </div>
                        </div>

                        <div class="control-group" data-mode="baked">
                            <h3>LM Gamma</h3>
                            <div class="slider-container">
                                <input type="range" id="lm-gamma-slider" min="0" max="3" step="0.05" value="1.3" />
                                <span id="lm-gamma-value">1.30</span>
                            </div>
                        </div>

                        <div class="control-group">
                            <h3>PBR Gain</h3>
                            <div class="slider-container">
                                <input type="range" id="pbr-gain-slider" min="0" max="2" step="0.05" value="1.1" />
                                <span id="pbr-gain-value">1.10</span>
                            </div>
                        </div>

                        <div class="control-group">
                            <h3>PBR Gamma</h3>
                            <div class="slider-container">
                                <input type="range" id="pbr-gamma-slider" min="0" max="2" step="0.05" value="1.05" />
                                <span id="pbr-gamma-value">1.05</span>
                            </div>
                        </div>

                        <div class="control-group">
                            <h3>Normal Str</h3>
                            <div class="slider-container">
                                <input type="range" id="normal-strength-slider" min="0" max="2" step="0.05" value="2.0" />
                                <span id="normal-strength-value">2.00</span>
                            </div>
                        </div>

                        <div class="control-group">
                            <h3>Specular</h3>
                            <div class="slider-container">
                                <input type="range" id="specular-amount-slider" min="0" max="2" step="0.05" value="1.0" />
                                <span id="specular-amount-value">1.00</span>
                            </div>
                        </div>
                    </div>

                    <div class="controls-row secondary-controls compact-controls">

                        <div class="control-group" data-mode="normal">
                            <h3>HDRI Rot</h3>
                            <div class="slider-container">
                                <input type="range" id="hdri-rotation-slider" min="0" max="360" step="1" value="270" />
                                <span id="hdri-rotation-value">270</span>
                            </div>
                        </div>

                        <div class="control-group" data-mode="normal">
                            <h3>HDRI Int</h3>
                            <div class="slider-container">
                                <input type="range" id="hdri-intensity-slider" min="0" max="5" step="0.1" value="0.8" />
                                <span id="hdri-intensity-value">0.80</span>
                            </div>
                        </div>

                        <div class="control-group" data-mode="normal">
                            <h3>Light Int</h3>
                            <div class="slider-container">
                                <input type="range" id="light-intensity-slider" min="0" max="5" step="0.1" value="0.5" />
                                <span id="light-intensity-value">0.50</span>
                            </div>
                        </div>

                        <div class="control-group" data-mode="normal">
                            <h3>Light Rot</h3>
                            <div class="slider-container">
                                <input type="range" id="light-rotation-slider" min="0" max="360" step="1" value="270" />
                                <span id="light-rotation-value">270</span>
                            </div>
                        </div>

                        <div class="control-group" data-mode="normal">
                            <h3>Fill Int</h3>
                            <div class="slider-container">
                                <input type="range" id="fill-intensity-slider" min="0" max="5" step="0.1" value="1.0" />
                                <span id="fill-intensity-value">1.00</span>
                            </div>
                        </div>
                    </div>

                    <div class="controls-row secondary-controls compact-controls velvet-controls">

                        <div class="control-group">
                            <h3>Normal Map</h3>
                            <div class="button-group mode-toggles" id="normal-map-toggles">
                                <button class="mode-btn active" data-normal="combined">Combined</button>
                                <button class="mode-btn" data-normal="raw">Raw</button>
                            </div>
                        </div>
                        <div class="control-group">
                            <h3>Sheen Intensity</h3>
                            <div class="slider-container">
                                <input type="range" id="sheen-intensity-slider" min="0.1" max="2" step="0.05" value="1.0" />
                                <span id="sheen-intensity-value">1.00</span>
                            </div>
                        </div>
                        <div class="control-group">
                            <h3>Sheen Roughness</h3>
                            <div class="slider-container">
                                <input type="range" id="sheen-roughness-slider" min="0" max="1" step="0.05" value="0.55" />
                                <span id="sheen-roughness-value">0.55</span>
                            </div>
                        </div>
                        <div class="control-group">
                            <h3>Sheen Color Gamma</h3>
                            <div class="slider-container">
                                <input type="range" id="sheen-color-gamma-slider" min="0.1" max="5" step="0.05" value="2.5" />
                                <span id="sheen-color-gamma-value">2.50</span>
                            </div>
                        </div>
                        <div class="control-group">
                            <h3>Sheen Desaturate</h3>
                            <div class="slider-container">
                                <input type="range" id="sheen-desaturation-slider" min="0" max="1" step="0.05" value="0.5" />
                                <span id="sheen-desaturation-value">0.50</span>
                            </div>
                        </div>
                        <div class="control-group">
                            <h3>Debug View</h3>
                            <select id="debug-mode-select" class="debug-select">
                                <option value="0">Off</option>
                                <option value="1">Custom Normal</option>
                                <option value="2">Sheen Color</option>
                                <option value="3">USE_SHEEN Check</option>
                                <option value="4">Pure Sheen (Direct+Indirect)</option>
                                <option value="5">Base Specular</option>
                                <!-- <option value="6">Debug: Tangents</option>
                                <option value="7">Debug: Bitangents</option>
                                <option value="8">Debug: Base Normal Map (Tangent Space)</option>
                                <option value="9">Debug: Sheen Normal Map (Tangent Space)</option> -->
                            </select>
                        </div>
                    </div>
                </details>
            )}
        </div>

        </div>
    </div>
</ConfiguratorLayout>

<style lang="scss">
    .configurator-full-layout {
        display: grid;
        grid-template-columns: minmax(0, 900px) 400px;
        justify-content: center;
        gap: 2rem;
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        align-items: start;
    }

    @media (max-width: 1024px) {
        .configurator-full-layout {
            grid-template-columns: 1fr;
        }
    }

    .viewer-column {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
    }

    .cc-preview-container {
        width: 100%;
        border-radius: 16px;
        overflow: hidden;
        background: rgb(207, 207, 207);
        border: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 200px;

        img {
            width: 100%;
            height: auto;
            display: block;
        }

        .empty-state {
            color: var(--color-500);
            font-size: 1rem;
            padding: 2rem;
        }
    }

    .top-controls {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
        color: var(--color-100);
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 1rem;
    }

    .debug-panel {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 1rem;

        summary {
            cursor: pointer;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--color-300);
            font-weight: 600;
            outline: none;
            user-select: none;
            transition: color 0.2s;

            &:hover {
                color: var(--color-100);
            }
        }

        &[open] summary {
            margin-bottom: 1rem;
            color: var(--color-100);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding-bottom: 0.5rem;
        }
    }

    .controls-row.primary-controls {
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;

        .control-group {
            min-width: 250px;
        }
    }

    .controls-row.compact-controls {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 0.5rem;
        margin-top: 0.5rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);

        .control-group {
            gap: 0.2rem;
            min-width: 0; /* allows shrinking */

            &.full-width {
                grid-column: 1 / -1;
                margin-bottom: 0.5rem;
            }

            h3 {
                font-size: 0.75rem;
                color: var(--color-500);
            }
        }

        .slider-container {
            padding: 0.3rem 0.6rem;
            gap: 6px;
            
            span {
                font-size: 0.75rem;
                min-width: 28px;
            }
        }

        .debug-select {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            padding: 0.4rem 0.6rem;
            border-radius: 6px;
            font-family: monospace;
            font-size: 0.8rem;
            width: 100%;
            outline: none;

            option {
                background: #222;
                color: #fff;
            }
        }
    }

    .control-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;

        h3 {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--color-400);
            margin: 0;
        }
    }

    .section-heading {
        font-size: 1.1rem;
        color: var(--color-200);
        margin-top: 1rem;
        margin-bottom: -0.5rem;
        border-bottom: 1px solid transparent;
    }

    .button-group {
        display: inline-flex;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.05);
        padding: 4px;
        border-radius: 8px;

        button {
            flex: 1;
            background: transparent;
            border: none;
            color: var(--color-300);
            padding: 0.6rem 1.5rem;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.3s ease;

            &.active {
                background: rgba(255, 255, 255, 0.15);
                color: var(--color-100);
                box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            }

            &:hover:not(.active) {
                background: rgba(255, 255, 255, 0.08);
            }
        }
    }

    .slider-container {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(255, 255, 255, 0.05);
        padding: 0.6rem 1rem;
        border-radius: 8px;
        height: 100%;

        input[type=range] {
            flex: 1;
            accent-color: var(--color-100);
            cursor: pointer;
        }

        span {
            font-family: monospace;
            font-size: 0.9rem;
            color: var(--color-300);
            min-width: 32px;
            text-align: right;
            font-weight: 600;
        }
    }

    .collection-buttons {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;

        .collection-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--color-300);
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s ease;

            &.active {
                background: var(--color-100);
                color: #000;
                border-color: var(--color-100);
            }

            &:hover:not(.active) {
                background: rgba(255, 255, 255, 0.1);
                border-color: rgba(255, 255, 255, 0.3);
                color: #fff;
            }
        }
    }

    .texture-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 0.5rem;

        .texture-btn {
            width: 90px;
            background: rgba(255, 255, 255, 0.03);
            border: 2px solid transparent;
            border-radius: 8px;
            padding: 0;
            cursor: pointer;
            overflow: hidden;
            display: none; /* Hidden by default, toggled by JS */
            flex-direction: column;
            transition: all 0.2s ease;
            text-align: left;

            &.visible {
                display: flex;
            }

            img {
                width: 100%;
                aspect-ratio: 1;
                object-fit: cover;
                border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            }

            .tex-info {
                padding: 8px;
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            .tex-code {
                font-size: 0.75rem;
                font-weight: 700;
                color: var(--color-100);
            }

            .tex-name {
                font-size: 0.65rem;
                color: var(--color-400);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            &:hover {
                transform: translateY(-2px);
                background: rgba(255, 255, 255, 0.08);
            }

            &.active {
                border-color: #fff;
                box-shadow: 0 0 0 2px rgba(255,255,255,0.2);
            }
        }
    }

    /* Split Viewer - PERFECT SQUARES */
    .viewer-split {
        display: flex;
        justify-content: center;
        width: 100%;
        max-width: 100%;
    }

    .viewer-3d, .viewer-render {
        background: rgb(207, 207, 207);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        overflow: hidden;
        position: relative;
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 100%;
        aspect-ratio: 1 / 1; /* PERFECT SQUARE */
    }

    #three-container {
        width: 100%;
        height: 100%;
        outline: none;
        display: block;
        flex: 1;
    }

    /* Force override any global canvas rules from layouts */
    #three-container canvas {
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        display: block !important;
    }

    .render-image-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        background: rgb(207, 207, 207);
        height: 100%;

        img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* Fill the square perfectly */
            display: none;
        }

        .empty-state {
            color: var(--color-500);
            font-size: 1rem;
        }
    }

    .overlay-group.angle-controls-group {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        align-items: center;
    }

    .viewer-overlay-controls {
        position: absolute;
        top: 1rem;
        left: 1rem;
        right: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        align-items: flex-start;
        z-index: 5;
        pointer-events: none;

        & > * {
            pointer-events: all;
        }

        .overlay-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            align-items: center;

            &.camera-group {
                position: absolute;
                top: 0;
                right: 0;
                align-items: flex-end;
            }

            .overlay-label {
                font-size: 0.75rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: rgba(255, 255, 255, 0.9);
                text-shadow: 0 1px 4px rgba(0,0,0,0.8);
            }
        }

        .button-group {
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            
            button {
                color: rgba(255, 255, 255, 0.7);
                font-size: 0.75rem;
                padding: 0.3rem 0.8rem;
                
                &.active {
                    background: rgba(255, 255, 255, 0.2);
                    color: #fff;
                }
                
                &:hover:not(.active) {
                    background: rgba(255, 255, 255, 0.1);
                }
            }
        }

        .reset-camera-btn {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            cursor: pointer;
            backdrop-filter: blur(4px);
            font-weight: 500;
            transition: all 0.2s ease;

            &:hover {
                background: rgba(0, 0, 0, 0.6);
                border-color: rgba(255, 255, 255, 0.4);
            }
        }
    }


    .viewer-overlay-bottom-left {
        position: absolute;
        bottom: 1rem;
        left: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        z-index: 5;
        pointer-events: none;

        & > * {
            pointer-events: all;
        }

        .slider-container {
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            width: 350px;
            
            /* Hidden by default unless velvet is active */
            &.velvet-slider {
                display: none;
                &.visible {
                    display: flex;
                }
            }

            .slider-label {
                font-family: inherit;
                font-size: 0.6rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: rgba(255, 255, 255, 0.8);
                width: 90px;
                text-align: left;
            }
            
            input[type=range] {
                width: 130px;
                flex: 1;
            }
            
            span:last-child {
                color: #fff;
                font-size: 0.65rem;
                width: 30px;
                text-align: right;
            }
        }
    }

    .loading-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(5px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        color: #fff;
        font-weight: 500;
        z-index: 10;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s;

        &.visible {
            opacity: 1;
            pointer-events: all;
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(255,255,255,0.1);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    @media (max-width: 1024px) {
        .viewer-split {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
    }
</style>

<script>
    import { initFabricViewer } from '../components/fabric-viewer';
    
    let cleanup: (() => void) | undefined | void;

    document.addEventListener('astro:page-load', () => {
        // Only initialize if the container is on the page
        if (document.getElementById('three-container')) {
            if (cleanup) cleanup();
            cleanup = initFabricViewer();
            
            // Setup debug toggle
            window.addEventListener('keydown', (e) => {
                if (e.altKey && e.key.toLowerCase() === 'd') {
                    e.preventDefault();
                    const debugPanel = document.getElementById('debug-panel');
                    if (debugPanel) {
                        debugPanel.style.display = debugPanel.style.display === 'none' ? 'block' : 'none';
                    }
                }
            });

            // Setup velvet toggle
            const materialToggles = document.getElementById('material-toggles');
            function updateVelvetSliders(isVelvet) {
                const velvetSliders = document.querySelectorAll('.velvet-slider');
                velvetSliders.forEach(el => {
                    if (isVelvet) {
                        el.classList.add('visible');
                    } else {
                        el.classList.remove('visible');
                    }
                });
            }
            
            // Initial check
            const initVelvetBtn = document.querySelector('.material-btn[data-material="velvet"]');
            if (initVelvetBtn && initVelvetBtn.classList.contains('active')) {
                updateVelvetSliders(true);
            }
            
            if (materialToggles) {
                materialToggles.addEventListener('click', (e) => {
                    const btn = (e.target).closest('.material-btn');
                    if (!btn) return;
                    const matType = btn.getAttribute('data-material');
                    updateVelvetSliders(matType === 'velvet');
                });
            }
        }
    });

    document.addEventListener('astro:before-swap', () => {
        if (cleanup) {
            cleanup();
            cleanup = undefined;
        }
    });
</script>
