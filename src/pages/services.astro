---
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CallToAction from "../components/CallToAction.astro";
import { pageTag, pageDescription, servicesTdk } from "../data/content";

const testimonials = [
  { text: "Oleh delivered high-quality 3D assets that met all technical specifications. His attention to material detail and lighting is excellent, and he followed the brief with precision. Professional, efficient, and highly recommended for technical design work." },
  { text: "It was a great experience working with Oleh. He has a broad range of knowledge, from rendering to modelling. He understood the brief very well and was always responsive and communicative throughout the process. He found creative solutions to the issues I was experiencing and delivered high-quality work." },
  { text: "Oleh has been very responsive, understand our needs, making our requested changes and providing quality results." },
  { text: "Oleh was great! Super proffesional and quick. Has relevant exprience and has provided amazing results. Will def work with him again. Very much recommended." },
  { text: "Oleh was very responsive and attentive to our brief! Would highly recommend for creative projects as well as high quality 3D modelling work." },
  { text: "Oleh was cooperative and communicative. I would use him for my render projects again in the future! I think we will have more coming down in the pipeline soon." },
  { text: "Oleh was easy to work with and was very prompt!" }
];
---

<BlogPostLayout
	title={servicesTdk.title || ""}
	description={servicesTdk.description || ""}
	keywords={servicesTdk.keywords || ""}
>
	<div class="post">
		<main class="post-wrapper about">
			<SectionHeader
				tag={pageTag.services}
				description={pageDescription.services}
			/>

			<section class="border-top" style="padding-top: 2rem;">
				<div class="content">
					<p>
						I offer reliable, high-quality, and procedurally optimized 3D modeling and rendering services. My workflow is tailored specifically for industrial, product, and architectural projects where precision and technical excellence are paramount.
					</p>
					
					<h3 class="post-title" style="margin-top: 2.5rem; margin-bottom: 1rem;">Pricing & Rates</h3>
					<p>
						I believe in clear, transparent rates tailored to project complexity, with no hidden fees.
					</p>
					<ul>
						<li>
							<strong>Hourly Rate ($50 / hr):</strong> Ideal for ongoing projects, consultations, pipeline development, or tasks with flexible scopes. This covers flexible hours, look development, and procedural automation.
						</li>
						<li>
							<strong>Project Based (Custom):</strong> For well-defined scopes. Some real-world examples from past projects include:
							<ul>
								<li><strong>Industrial Equipment Visualization:</strong> $75 - $250 <em>(Average: $150 per machine)</em></li>
								<li><strong>Furniture Model Rendering:</strong> $50 - $200 <em>(Per model render)</em></li>
							</ul>
						</li>
					</ul>

					<h3 class="post-title" style="margin-top: 2.5rem; margin-bottom: 1rem;">Work Policies & Process</h3>
					<p>How we ensure smooth collaboration and successful delivery:</p>
					<ul>
						<li>
							<strong>Revisions:</strong> 2 rounds of revisions are included in every fixed-price project to ensure the final result perfectly matches your vision.
						</li>
						<li>
							<strong>Payment Milestones:</strong> For fixed-price contracts, we utilize the Upwork Milestone Program. Payments are securely funded before work begins and released upon your approval of the deliverables.
						</li>
						<li>
							<strong>Communication:</strong> Expect clear, responsive, and technical communication. I keep you updated at every major step of the pipeline so there are no surprises.
						</li>
					</ul>

					<h3 class="post-title" style="margin-top: 2.5rem; margin-bottom: 1rem;">Client Feedback</h3>
					<p>Don't just take my word for it. Here is some feedback from past clients on Upwork:</p>
					
					{testimonials.map((quote) => (
						<blockquote style="margin: 1.5rem 0; padding-left: 1.25rem; border-left: 4px solid var(--color-blue); font-style: italic; color: var(--color-300);">
							"{quote.text}"
						</blockquote>
					))}

					<p style="margin-top: 4rem; text-align: center;">
						<CallToAction
							href="https://www.upwork.com/freelancers/sydoryk"
							target="_blank"
						>
							Let's Work Together
						</CallToAction>
					</p>
				</div>
			</section>
		</main>
	</div>
</BlogPostLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		margin: 0 auto;
	}
	p {
		margin: 0.75rem 0;
		line-height: 1.6;
	}
	ul {
		margin-top: 0.5rem;
		margin-bottom: 1.5rem;
	}
	li {
		margin-bottom: 0.75rem;
		line-height: 1.6;
	}
	a,
	a:link {
		color: var(--color-blue);
	}
</style>
