---
import ConfiguratorLayout from "../../layouts/ConfiguratorLayout.astro";
---

<ConfiguratorLayout title="Ring Configurator">
    <div class="config-wrapper">
        <div class="viewport">
            <div class="canvas-wrapper">
                <canvas id="configCanvas" width="1200" height="1200"></canvas>
            </div>

            <div class="loader-container">
                <div class="progress-bar">
                    <div id="progress-fill" style="width: 0%"></div>
                </div>
                <div id="progress-text">Initializing assets...</div>
            </div>
        </div>

        <div class="controls-panel">
            <div class="scroll-container">
                
                <section class="control-section">
                    <h4>Collection</h4>
                    <div class="button-grid">
                        {['Fernweh', 'Bellevue', 'Malgari', 'Prince'].map((p) => (
                            <button class="view-btn" data-type="product" data-value={p}>{p}</button>
                        ))}
                    </div>
                </section>

                <section class="control-section" id="stone-section">
                    <h4>Stone Selection</h4>
                    <div class="swatch-row">
                        <button class="swatch" data-type="stone" data-value="Diamond" style="background: radial-gradient(circle, #fff, #b9d8e3);" title="Diamond"></button>
                        <button class="swatch" data-type="stone" data-value="Emerald" style="background: #2e8b57;" title="Emerald"></button>
                        <button class="swatch" data-type="stone" data-value="Sapphire" style="background: #191970;" title="Sapphire"></button>
                    </div>
                </section>

                <section class="control-section" id="stamp-section">
                    <h4>Hallmark</h4>
                    <div class="button-grid hallmark-grid">
                        {['95', '375', '750', '925'].map((s) => (
                            <button class="view-btn" data-type="stamp" data-value={s}>{s}</button>
                        ))}
                    </div>
                </section>

                <div class="slider-group">
                    <section class="control-section">
                        <div class="label-row">
                            <h4>Oxidation</h4>
                            <span id="val-oxidised">80%</span>
                        </section>
                        <input type="range" id="slider-oxidised" min="0" max="100" value="80" class="config-slider">
                    </section>
                    
                    <section class="control-section">
                        <div class="label-row">
                            <h4>Dirt / Patina</h4>
                            <span id="val-dirt">80%</span>
                        </div>
                        <input type="range" id="slider-dirt" min="0" max="100" value="80" class="config-slider">
                    </section>
                </div>

                <section class="control-section">
                    <h4>Camera</h4>
                    <div class="button-grid camera-grid">
                        {['front', 'front-tilt', 'side', 'side-tilt', 'closeup-front', 'closeup-stamp'].map((c) => (
                            <button class="view-btn" data-type="camera" data-value={c}>{c.replace('-', ' ')}</button>
                        ))}
                    </div>
                </section>

            </div>
        </div>
    </div>
</ConfiguratorLayout>

<style>
    .config-wrapper { 
        display: flex; 
        flex-direction: row; 
        gap: 20px; 
        max-width: 1800px; /* Increased to allow more room */
        margin: 0 auto; 
        min-height: 100vh; /* Changed from fixed height to min-height */
        padding: 20px; 
        color: #fff; 
        align-items: flex-start;
    }

    @media (max-width: 1200px) { 
        .config-wrapper { flex-direction: column; align-items: center; } 
        .controls-panel { width: 100% !important; max-width: 600px; }
    }

    .viewport { 
        flex: 3; /* Give more priority to the ring */
        background: #000; 
        position: relative; 
        border-radius: 4px; 
        display: flex; 
        align-items: center; 
        justify-content: center;
        min-width: 0; /* Prevents flex items from overflowing */
    }

    .canvas-wrapper { 
        width: 100%; 
        max-width: 1200px; /* Matches original resolution */
        aspect-ratio: 1 / 1;
        position: relative;
    }

    canvas { 
        width: 100%; 
        height: auto; 
        display: block;
        image-rendering: -webkit-optimize-contrast; /* Keeps the ring sharp when scaled */
    }

    .controls-panel { 
        flex: 1; 
        min-width: 340px; 
        position: sticky; /* Keeps controls visible while scrolling the ring */
        top: 20px;
        background: #0f0f0f; 
        border: 1px solid #222; 
        border-radius: 8px; 
        max-height: calc(100vh - 40px);
        display: flex; 
        flex-direction: column; 
    }
    .scroll-container { padding: 20px; overflow-y: auto; }
    .control-section { margin-bottom: 1.5rem; }
    .control-section h4 { font-size: 11px; text-transform: uppercase; color: #666; margin-bottom: 10px; letter-spacing: 1px;}
    .slider-group { background: #151515; padding: 20px 15px; border-radius: 8px; margin-bottom: 2rem; border: 1px solid #222; }
    .label-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .label-row span { font-size: 11px; color: #fff; font-family: monospace; }
    .config-slider { -webkit-appearance: none; width: 100%; height: 2px; background: #333; outline: none; margin: 10px 0; }
    .config-slider::-webkit-slider-thumb { -webkit-appearance: none; width: 18px; height: 18px; background: #fff; border-radius: 50%; cursor: pointer; border: 4px solid #0f0f0f; }
    .button-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .hallmark-grid { grid-template-columns: repeat(4, 1fr); }
    .view-btn { background: #1a1a1a; border: 1px solid #333; color: #777; padding: 12px; cursor: pointer; font-size: 11px; text-transform: uppercase; }
    .view-btn.active { background: #fff; color: #000; border-color: #fff; }
    .swatch { width: 40px; height: 40px; border-radius: 50%; border: 2px solid #333; cursor: pointer; }
    .swatch.active { border-color: #fff; transform: scale(1.1); }
    .loader-container { position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); width: 250px; background: rgba(0,0,0,0.9); padding: 15px; border-radius: 8px; border: 1px solid #222; transition: opacity 0.5s; z-index: 100;}
    .progress-bar { width: 100%; height: 2px; background: #222; margin-bottom: 8px; }
    #progress-fill { height: 100%; background: #fff; width: 0%; transition: width 0.2s; }
    #progress-text { font-size: 9px; color: #555; text-transform: uppercase; }
    .disabled { opacity: 0.15; pointer-events: none; filter: grayscale(1); transition: opacity 0.3s; }
</style>

<script>
    const CONFIG = { 
        basePath: "/assets/projects/rings/",
        options: {
            products: ['Fernweh', 'Bellevue', 'Malgari', 'Prince'],
            stones: ['Diamond', 'Emerald', 'Sapphire'],
            stamps: ['95', '375', '750', '925'],
            cameras: ['front', 'front-tilt', 'side', 'side-tilt', 'closeup-front', 'closeup-stamp']
        }
    };

    // --- UPDATED DEFAULTS ---
    let state = { 
        product: 'Malgari', 
        stone: 'Sapphire', 
        stamp: '750', 
        camera: 'front-tilt', 
        oxidised: 50, 
        dirt: 80 
    };
    
    const canvas = document.getElementById("configCanvas");
    const ctx = canvas.getContext("2d");
    const imageCache = {};

    const bufferCanvas = document.createElement('canvas');
    bufferCanvas.width = 1200; bufferCanvas.height = 1200;
    const bCtx = bufferCanvas.getContext('2d');

    const tempCanvas = document.createElement('canvas');
    tempCanvas.width = 1200; tempCanvas.height = 1200;
    const tCtx = tempCanvas.getContext('2d');

    const shouldShowLayer = (layer) => {
        if (layer === 'stone') return state.product !== 'Prince' && state.camera !== 'closeup-stamp';
        if (layer === 'stamp') return state.camera !== 'front';
        return true;
    };

    function getPath(layer, d, o) {
        if (layer === 'bg') return `${CONFIG.basePath}BG_${state.camera}.webp`;
        if (!shouldShowLayer(layer)) return undefined;

        const { product, stone, stamp, camera } = state;
        const sL = stone.toLowerCase();
        let f;
        switch(layer) {
            case 'main': f = `main_${product}_${camera}_${d}_corr-${o}.webp`; break;
            case 'stone': f = `stone_${product}_${sL}_${camera}_${d}_corr-${o}.webp`; break;
            case 'stamp': f = `stamp_${product}_${stamp}_${camera}_${d}_corr-${o}.webp`; break;
        }
        return `${CONFIG.basePath}${product}/${f}`;
    }

    function checkReady(url) {
        if (!url) return true;
        const img = imageCache[url];
        if (img && img.complete && img.naturalWidth > 0) return true;
        if (!img) {
            const n = new Image();
            n.src = url;
            imageCache[url] = n;
            n.onload = () => render();
        }
        return false;
    }

    function render() {
        const dFac = state.dirt / 100;
        const oFac = state.oxidised / 100;

        bCtx.clearRect(0, 0, 1200, 1200);

        const layers = [
            { id: 'bg', blend: 'source-over', dynamic: false },
            { id: 'main', blend: 'source-over', dynamic: true },
            { id: 'stamp', blend: 'screen', dynamic: true }, 
            { id: 'stone', blend: 'screen', dynamic: true }
        ];

        let allImagesReady = true;

        layers.forEach(l => {
            if (!shouldShowLayer(l.id)) return;

            if (!l.dynamic) {
                const path = getPath(l.id, 'clean', 'no');
                if (!checkReady(path)) allImagesReady = false;
                
                bCtx.globalCompositeOperation = 'source-over';
                const img = imageCache[path];
                if (img) bCtx.drawImage(img, 0, 0);
            } else {
                const paths = [
                    getPath(l.id, 'clean', 'no'),
                    getPath(l.id, 'dirty', 'no'),
                    getPath(l.id, 'clean', 'yes'),
                    getPath(l.id, 'dirty', 'yes')
                ];

                if (!paths.every(checkReady)) {
                    allImagesReady = false;
                    return; 
                }

                tCtx.clearRect(0, 0, 1200, 1200);
                tCtx.globalCompositeOperation = 'source-over';
                
                tCtx.globalAlpha = 1.0;
                tCtx.drawImage(imageCache[paths[0]], 0, 0);

                tCtx.globalAlpha = dFac;
                tCtx.drawImage(imageCache[paths[1]], 0, 0);

                tCtx.globalAlpha = oFac * (1 - dFac);
                tCtx.drawImage(imageCache[paths[2]], 0, 0);
                
                tCtx.globalAlpha = oFac * dFac;
                tCtx.drawImage(imageCache[paths[3]], 0, 0);

                bCtx.globalCompositeOperation = l.blend;
                bCtx.globalAlpha = 1.0;
                bCtx.drawImage(tempCanvas, 0, 0);
            }
        });

        if (allImagesReady) {
            ctx.clearRect(0, 0, 1200, 1200);
            ctx.drawImage(bufferCanvas, 0, 0);
        }
    }

    document.querySelectorAll('[data-type]').forEach(btn => {
        btn.addEventListener('click', () => {
            state[btn.dataset.type] = btn.dataset.value;
            syncUI();
            render();
        });
    });

    document.getElementById('slider-oxidised').addEventListener('input', (e) => {
        state.oxidised = parseInt(e.target.value);
        document.getElementById('val-oxidised').innerText = `${state.oxidised}%`;
        render();
    });

    document.getElementById('slider-dirt').addEventListener('input', (e) => {
        state.dirt = parseInt(e.target.value);
        document.getElementById('val-dirt').innerText = `${state.dirt}%`;
        render();
    });

    function syncUI() {
        document.querySelectorAll('[data-type]').forEach(el => {
            el.classList.toggle('active', state[el.dataset.type] === el.dataset.value);
        });
        document.getElementById('stone-section').classList.toggle('disabled', !shouldShowLayer('stone'));
        document.getElementById('stamp-section').classList.toggle('disabled', !shouldShowLayer('stamp'));
    }

    function initPreload() {
        const list = [];
        CONFIG.options.products.forEach(p => {
            CONFIG.options.cameras.forEach(c => {
                ['clean', 'dirty'].forEach(d => {
                    ['no', 'yes'].forEach(o => {
                        list.push(`${CONFIG.basePath}${p}/main_${p}_${c}_${d}_corr-${o}.webp`);
                        if (c !== 'front') list.push(`${CONFIG.basePath}${p}/stamp_${p}_375_${c}_${d}_corr-${o}.webp`);
                        if (p !== 'Prince' && c !== 'closeup-stamp') {
                            CONFIG.options.stones.forEach(s => {
                                list.push(`${CONFIG.basePath}${p}/stone_${p}_${s.toLowerCase()}_${c}_${d}_corr-${o}.webp`);
                            });
                        }
                    });
                });
            });
        });

        const unique = [...new Set(list)];
        let loaded = 0;
        const total = unique.length;

        function loadBatch() {
            if (unique.length === 0) return;
            const url = unique.shift();
            const img = new Image();
            img.src = url;
            img.onload = img.onerror = () => {
                imageCache[url] = img;
                loaded++;
                const fill = document.getElementById('progress-fill');
                if(fill) fill.style.width = (loaded/total*100)+'%';
                if (loaded === total) setTimeout(() => document.querySelector('.loader-container').style.opacity = '0', 800);
                loadBatch();
                render(); 
            };
        }
        for(let i=0; i<8; i++) loadBatch();
    }

    syncUI();
    render();
    window.addEventListener('load', initPreload);
</script>