---
import { Image } from "astro:assets";
import DetailHeader from "../../components/DetailHeader.astro";
import DetailPostLayout from "../../layouts/DetailPostLayout.astro";

import CAD_01 from "../../assets/projects/IndustrialEquipment/CAD_01.jpg";
import CAD_02 from "../../assets/projects/IndustrialEquipment/CAD_02.jpg";
import CAD_03 from "../../assets/projects/IndustrialEquipment/CAD_03.jpg";
import CAD_04 from "../../assets/projects/IndustrialEquipment/CAD_04.jpg";
import CAD_05 from "../../assets/projects/IndustrialEquipment/CAD_05.jpg";
import CAD_06 from "../../assets/projects/IndustrialEquipment/CAD_06.jpg";
import CAD_07 from "../../assets/projects/IndustrialEquipment/CAD_07.jpg";
import CAD_mozaic from "../../assets/projects/IndustrialEquipment/CAD_mozaic.jpg";

---
<DetailPostLayout
	title="Industrial Equipment Visualization"
	description = '3D Industrial Equipment Visualization from CAD files',
	keywords = '3D, Product Visualization, Industrial, CAD',
>
	<div class="post">
		<main class="post-wrapper">
			<DetailHeader
			tag="PROJECT"
			description="">
					<h1 class="font-type">
						Industrial Equipment
					</h1>
			</DetailHeader>

			<section>
				<div class="content">
					<div class="row desc">
						<div class="col-1a">
							<p class="post-desc">
								<p>
								The client needed high-quality visualizations of industrial equipment based on existing CAD files. 
								The original CAD models required cleanup and conversion to polygonal geometry before they could be used for production-level rendering.
								</p>
								<p>
								Here is new client website featuring new renders: <a href="https://www.fnsmithcorp.com/">https://www.fnsmithcorp.com/</a>
								</p>
								<p>
								I developed a clean, efficient workflow in Houdini to ensure realistic and consistent results across all assets. 
								</p>
								<p>
								My work included:
								</p>

								<ul>
								<li>converting STEP files into detailed polygonal models (using MOI)</li>
								<li>modeling missing components (such as the blue conveyer)</li>
								<li>creating and assigning correct materials</li>
								<li>creating custom textures</li>
								<li>building a realistic studio lighting setup</li>
								<li>post-processing and delivering all images in a unified visual style</li>
								</ul>

								<p>
								Each system was rendered in two variants: one with a transparent background and one with a studio background. 
								Additionally, I produced blueprint-style renders.
								</p>
								<p>Collage of multiple systems:
								<Image src={CAD_mozaic} alt="Multiple renders"/>
								</p>

								<p>Individual renders:
								<Image src={CAD_01} alt="Render of industrial equipment 1"/>
								<Image src={CAD_02} alt="Render of industrial equipment 2"/>
								<Image src={CAD_03} alt="Render of industrial equipment 3"/>
								<Image src={CAD_05} alt="Render of industrial equipment 5"/>
								<Image src={CAD_06} alt="Render of industrial equipment 6"/>
								<Image src={CAD_07} alt="Render of industrial equipment 7"/>
								</p>

								<p>Bluepring style render:
									<video width="100%" autoplay loop muted>
										<source src="/assets/projects/IndustrialEquipment/IndustrialEquipment_wireframe.mp4" type="video/mp4">
									</video>
								</p>
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>
	</div>
</DetailPostLayout>

<style>
img{
	border:1px solid #ececec;
}
.btn{
	display: flex;
	gap: 16px;
}
</style>
