---
import { Image } from "astro:assets";
import DetailHeader from "../../components/DetailHeader.astro";
import DetailPostLayout from "../../layouts/DetailPostLayout.astro";

import ideas from "../../assets/projects/adtea/ideas.webp";
import image2 from "../../assets/projects/adtea/Picture2.png";
import image3 from "../../assets/projects/adtea/Picture3.png";
import image4 from "../../assets/projects/adtea/Picture4.png";
import image5 from "../../assets/projects/adtea/Picture5.jpg";

---
<DetailPostLayout
	title="Tea ad"
	description = 'Ad for a tea',
	keywords = 'Tea, Ad Animation',
>
	<div class="post">
		<main class="post-wrapper">
			<DetailHeader
			tag="PROJECT"
			description="">
					<h1 class="font-type">
						Tea ad
					</h1>
			</DetailHeader>

			<section>
				<div class="content">
					<div class="row desc">
						<div class="col-1a">
							<p class="post-desc">
								<p>The client required animation for winter tea.</p>
								<p>I provided few ideas, their description and approxiamate cost.</p>
								<p>Using AI, I generated storyboard for each idea. Here are few examples: </p>
								<Image src={ideas} alt="Concepts for an ad" />
								<br>
								<p>I created procedural animation for ingredients falling into the cup and water simulation. </p>
								<p>Here is final result after few iterations: 
								<section class="preview" oncontextmenu="return false;">
									<video width="100%" autoplay loop muted controlslist="nodownload">
										<source src="/assets/projects/adtea/adtea_1500p.mp4">
									</video>
								</section>
								</p>
							</p>
						</div>
					</div>
				</div>
			</section>
		</main>
	</div>
</DetailPostLayout>

<style>
img{
	border:1px solid #ececec;
}
.btn{
	display: flex;
	gap: 16px;
}
</style>