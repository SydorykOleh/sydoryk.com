---
import { getEntry } from "astro:content";
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CallToAction from "../components/CallToAction.astro";
import { pageTag, pageDescription, experienceTdk } from "../data/content";

const artistEntry = await getEntry("experience", "lrc");
const taEntry = await getEntry("experience", "technical");
const itEntry = await getEntry("experience", "it");

if (!artistEntry || !taEntry || !itEntry) {
	throw new Error(
		"Could not load experience content entries from collection.",
	);
}

const { Content: ArtistContent } = await artistEntry.render();
const { Content: TAContent } = await taEntry.render();
const { Content: ITContent } = await itEntry.render();
---

<BlogPostLayout
	title={experienceTdk.title || ""}
	description={experienceTdk.description || ""}
	keywords={experienceTdk.keywords || ""}
>
	<div class="post">
		<main class="post-wrapper about">
			<SectionHeader
				tag={pageTag.experience}
				description={pageDescription.experience}
			/>

			<div class="section filter">
				<div class="border-bottom">
					<div
						class="row filter-wrapper relative overflow-hidden col-1a"
					>
						<ul class="flex filter-list filter-options">
							<button
								class="filter-item filter-tag active"
								data-tab="lrc"
							>
								LRC Artist
							</button>
							<button
								class="filter-item filter-tag"
								data-tab="technical"
							>
								Technical Artist
							</button>
							<button
								class="filter-item filter-tag"
								data-tab="it"
							>
								IT & Systems Specialist
							</button>
						</ul>
					</div>
				</div>
			</div>

			<section class="border-top" style="padding-top: 2rem;">
				<!-- Creative Resume Content -->
				<div
					class="content resume-tab-content active"
					id="tab-lrc"
				>
					<ArtistContent />
				</div>

				<!-- Technical Resume Content -->
				<div
					class="content resume-tab-content"
					id="tab-technical"
					style="display: none;"
				>
					<TAContent />
				</div>

				<!-- IT Resume Content -->
				<div
					class="content resume-tab-content"
					id="tab-it"
					style="display: none;"
				>
					<ITContent />
				</div>

				<p style="margin-top:24px;">
					<CallToAction
						target="_self"
						id="pdf-download-btn"
						href="/assets/resume_SydorykOleh.pdf"
						target="_blank"
					>
						PDF
					</CallToAction>
				</p>
			</section>
		</main>
	</div>
</BlogPostLayout>

<script>
	document.addEventListener('astro:page-load', () => {
		const buttons = document.querySelectorAll(".filter-tag[data-tab]");
		if (buttons.length === 0) return;

		const contents = document.querySelectorAll(".resume-tab-content");
		const pdfButton = document.getElementById("pdf-download-btn");
		const filterContainer = document.querySelector(".section.filter");
		const resumeSection = document.querySelector("section.border-top");

		const pdfLinks = {
			"lrc": "/assets/resume_SydorykOleh.pdf",
			"technical": "/assets/resume_SydorykOleh_TA.pdf",
			"it": "/assets/resume_SydorykOleh_IT.pdf",
		};

		function switchTab(tab) {
			buttons.forEach((btn) => {
				if (btn.getAttribute("data-tab") === tab) {
					btn.classList.add("active");
				} else {
					btn.classList.remove("active");
				}
			});

			contents.forEach((content) => {
				if (content.id === `tab-${tab}`) {
					content.style.display = "block";
					content.classList.add("active");
				} else {
					content.style.display = "none";
					content.classList.remove("active");
				}
			});

			if (pdfButton && pdfLinks[tab]) {
				pdfButton.setAttribute("href", pdfLinks[tab]);
			}
		}

		// Run immediately on parse to prevent flicker
		const urlParams = new URLSearchParams(window.location.search);
		const tabParam = urlParams.get("tab");
		const hideParam = urlParams.get("hide-switch");

		if (tabParam && pdfLinks[tabParam]) {
			switchTab(tabParam);
		}

		if (hideParam === "true") {
			if (filterContainer) {
				filterContainer.style.display = "none";
			}
			if (resumeSection) {
				resumeSection.classList.remove("border-top");
				resumeSection.style.paddingTop = "0";
			}
		}

		// Attach click listeners
		buttons.forEach((button) => {
			button.addEventListener("click", () => {
				const tab = button.getAttribute("data-tab");
				if (tab) {
					switchTab(tab);
					const url = new URL(window.location.href);
					url.searchParams.set("tab", tab);
					window.history.replaceState({}, "", url);
				}
			});
		});
	});
</script>

<style lang="scss">
	:root {
		--filter-bg: #fff;
		--filter-bg-active: #0a0a0a;
		--filter-bg-hover: rgba(10, 10, 10, 0.08);
		--filter-color: #101010;
		--filter-color-active: #f4f3f0;
		--filter-border: 1px solid #d0d0d0;
	}

	:root.theme-dark {
		--filter-bg: #19191b;
		--filter-color: #d6d5d4;
		--filter-color-active: #19191b;
		--filter-border: 1px solid #696765;
		--filter-bg-active: #f4f3f0;
		--filter-bg-hover: rgba(243, 244, 247, 0.08);
	}

	.filter {
		&-wrapper {
			margin: 1rem 0 1rem;
		}
		&-list {
			display: flex;
			gap: 12px;
			flex-wrap: wrap;
			justify-content: center;
			margin: auto;
			padding: 0;
			list-style: none;
		}
		&-item {
			display: inline-flex;
		}
		&-tag {
			border-radius: 32px;
			background-color: var(--filter-bg);
			padding: 10px 24px;
			font-size: 15px;
			font-family: var(--font-body);
			border: var(--filter-border);
			line-height: 1;
			letter-spacing: 0.25px;
			color: var(--filter-color);
			text-align: center;
			cursor: pointer;
			transition: all 0.35s cubic-bezier(0.075, 0.82, 0.165, 1);

			&:hover {
				background-color: var(--filter-bg-hover);
				color: var(--filter-color);
			}
			&.active {
				font-weight: 500;
				background: var(--filter-bg-active);
				color: var(--filter-color-active);
			}
		}
	}

	.about {
		display: flex;
		flex-direction: column;
		margin: 0 auto;
	}
	p {
		margin: 0.75rem 0;
	}
	figure {
		margin: 2rem 0;
	}
	img {
		max-width: 100%;
	}
	.portrait {
		border-radius: 100px;
		margin: 12px 0 12px;
		overflow: hidden;
		text-align: left;
	}
	a,
	a:link {
		color: var(--color-blue);
	}
</style>
