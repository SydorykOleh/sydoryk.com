---
import { Image } from "astro:assets";
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CallToAction from "../components/CallToAction.astro";
import { pageTag, pageDescription, aboutTdk } from "../data/content";
import myPortrait from "../assets/portrait.webp";
---

<BlogPostLayout
	title={aboutTdk.title || ""}
	description={aboutTdk.description || ""}
	keywords={aboutTdk.keywords || ""}
>
	<div class="post">
		<main class="post-wrapper about">
			<SectionHeader
				tag={pageTag.about}
				description={pageDescription.about}
			/>

			<section class="border-top" style="padding-top: 2rem;">
				<div class="content">
					<div>
						<Image
							src={myPortrait}
							alt="Oleh Sydoryk Portrait"
							width="250"
							height="250"
							class="portrait"
						/>
					</div>
					<p>
						I'm <strong style="font-size:1.2em">Sydoryk Oleh</strong
						>. With over 9 years of hands-on experience in the CGI
						industry, I bridge the gap between creative artistry and
						technical engineering. My expertise spans the entire
						production pipeline: from asset and environment modeling
						to look development, lighting, and final compositing.
					</p>
					<p>
						Lately, my focus is dedicated entirely to look
						development and layout using a modern USD workflow
						within <strong>Houdini and Solaris</strong>. I
						specialize in building procedural assets, optimizing
						rendering efficiency, and developing automation tools
						that turn complex technical challenges into streamlined,
						artist-friendly workflows.
					</p>
					<p>
						Whether you need a rock-solid lighting pipeline
						established or a fully procedural visualization system
						built from scratch, I bring the technical
						problem-solving required for high-end productions.
					</p>
					<p>
						I am currently available for selective freelance
						contracts, part-time technical direction, and remote
						pipeline consulting.
					</p>
					<p style="margin-top:24px;">
						<CallToAction
							href="https://www.upwork.com/freelancers/sydoryk"
							target="_blank"
						>
							UPWORK
						</CallToAction>
					</p>
				</div>
			</section>

			<section>
				<h3 class="post-title">Outside Work</h3>
				<div class="content">
					<p>
						When I’m not pushing pixels or optimizing render queues
						for clients, I’m usually tinkering with technology. I
						treat my personal website as a testing ground for modern
						web frameworks, maintain a high-availability homelab
						infrastructure, and experiment with game development. I
						also love building custom automation projects, like
						combining procedurals in Houdini with web APIs to
						auto-publish content.
					</p>
					<p>
						To unplug, I step away from the monitors for long walks
						to clear my head, usually fueled by a great cup of
						coffee.
					</p>
				</div>
			</section>
		</main>
	</div>
</BlogPostLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		margin: 0 auto;
	}
	p {
		margin: 0.75rem 0;
	}
	figure {
		margin: 2rem 0;
	}
	img {
		max-width: 100%;
	}
	.portrait {
		border-radius: 250px;
		margin: 12px auto 24px;
		display: block;
		overflow: hidden;
	}
	a,
	a:link {
		color: var(--color-blue);
	}
	.avatar {
		display: inline-block;
		position: relative;
		line-height: 1;
		width: 0px;
		height: 0px;
		border-radius: 50%;
	}
</style>
