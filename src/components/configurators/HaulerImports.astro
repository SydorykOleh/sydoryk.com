---
import ConfiguratorLayout from "../../layouts/ConfiguratorLayout.astro";
---

<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js"></script>

<ConfiguratorLayout
    title="Hauler Imports 3D Demo"
    description="Interactive 3D model demo for Hauler Imports"
    keywords="3D model, hauler imports, demo"
>
    <Fragment slot="controls">
        <div class="control-body">
            <div class="control-section">
                <h4>Color Options</h4>
                <div class="button-group" id="color-controls">
                    <button class="color-btn selected" data-color="#3F1919">Red</button>
                    <button class="color-btn" data-color="#193F1D">Green</button>
                    <button class="color-btn" data-color="#192A3F">Blue</button>
                </div>
            </div>
        </div>
    </Fragment>

    <div class="canvas-wrapper">
        <model-viewer id="color" alt="Interactive 3D Demo" src="/assets/3d/test.glb" ar environment-image="/assets/3d/lightroom_14b.hdr" shadow-intensity="1.5" shadow-softness="0.8" exposure="1.1" camera-controls auto-rotate rotation-per-second="15deg" touch-action="pan-y" interaction-prompt="none"></model-viewer>
    </div>

    <Fragment slot="config-description">
        <div class="content">
            <div class="row desc">
                <div class="col-1a">
                    <div class="post-desc">
                        <p>This is an interactive 3D model demo originally created for Hauler Imports. You can rotate the model and change its colors in real-time right in your browser.</p>
                        
                        <h3>Check out my other 3D Model Examples:</h3>
                        <ul>
                            <li><a href="/detail/Headphones">Headphones Configurator (Interactive)</a></li>
                            <li><a href="/detail/MicConfigurator">Microphone Configurator (Interactive)</a></li>
                            <li><a href="/detail/IndustrialEquipment">Industrial Equipment Visualization</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </Fragment>
</ConfiguratorLayout>

<style>
    .canvas-wrapper {
        position: relative;
        width: 100%;
        max-width: 1200px;
        height: 70vh;
        min-height: 500px;
        margin: 0 auto;
        border-radius: 16px;
        overflow: hidden;
        background: radial-gradient(circle at center, #252525 0%, #000000 100%);
        box-shadow: inset 0 0 100px rgba(0,0,0,0.8), 0 10px 40px rgba(0,0,0,0.5);
        border: 1px solid #222;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    model-viewer {
        width: 100%;
        height: 100%;
        display: block;
        background-color: transparent;
        outline: none;
    }

    .control-body { padding: 20px 0; }
    .control-section { margin-bottom: 32px; }
    .control-section h4 {
        margin: 0 0 15px 0;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #888;
    }

    .button-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .color-btn {
        background: #1a1a1a;
        border: 1px solid #333;
        color: #777;
        padding: 12px;
        cursor: pointer;
        font-size: 14px;
        text-transform: uppercase;
        transition: all 0.2s;
        border-radius: 4px;
    }

    .color-btn:hover {
        background: #2a2a2a;
        color: #aaa;
    }

    .color-btn.selected {
        background: #fff;
        color: #000;
        border-color: #fff;
    }

    .post-desc a {
        color: var(--color-blue);
        text-decoration: none;
    }
    
    .post-desc a:hover {
        text-decoration: underline;
    }
</style>

<script>
    const modelViewerColor = document.querySelector("model-viewer#color");
    const buttons = document.querySelectorAll('.color-btn');

    document.querySelector('#color-controls').addEventListener('click', (event) => {
        if (!event.target.classList.contains('color-btn')) return;
        
        const colorString = event.target.dataset.color;
        
        // Wait for the model to be fully loaded before setting materials
        if (modelViewerColor && modelViewerColor.model) {
            const materials = modelViewerColor.model.materials;
            if (materials && materials.length > 0) {
                const material = materials[0];
                material.pbrMetallicRoughness.setBaseColorFactor(colorString);
            }
        }

        buttons.forEach(btn => btn.classList.remove('selected'));
        event.target.classList.add('selected');
    });
</script>
