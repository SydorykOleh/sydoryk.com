---
import ConfiguratorLayout from "../../layouts/ConfiguratorLayout.astro";
---

<ConfiguratorLayout
    title="Elaré Jewelry 360 Turntable Review"
    description="Interactive 360-degree turntable review system for Elaré luxury jewelry catalog."
    keywords="Jewelry, 360 Rotation, Turntable, Product Viewer, Pre-rendered, WebP, Elare"
>
    <!-- Viewport Stage (Canvas + Overlay + Loader) -->
    <div class="turntable-stage" id="turntableStage">
        <div class="canvas-wrapper" id="canvasWrapper">
            <!-- GPU Nuke-Style Grade LUT Filter (Gain & Gamma) -->
            <svg width="0" height="0" style="position: absolute; width: 0; height: 0; pointer-events: none;" aria-hidden="true">
                <defs>
                    <filter id="elareGradeFilter" color-interpolation-filters="sRGB">
                        <feComponentTransfer>
                            <feFuncR id="gradeFuncR" type="identity"></feFuncR>
                            <feFuncG id="gradeFuncG" type="identity"></feFuncG>
                            <feFuncB id="gradeFuncB" type="identity"></feFuncB>
                        </feComponentTransfer>
                    </filter>
                </defs>
            </svg>
            <canvas id="configCanvas" width="1000" height="1000"></canvas>
            
            <div id="rotate-hint">
                <span class="mouse-icon">🖱️</span>
                <span class="hint-text">Drag to rotate • Space for autoplay</span>
            </div>

            <div id="version-badge" class="canvas-version-badge">v003 • 1000px</div>

            <div id="loader">Loading Turntable...</div>

            <div id="missingProductNotice" class="empty-notice missing-piece-notice" style="display: none;">
                <div class="missing-badge" id="missingItemNum">#2</div>
                <h3 id="missingItemTitle">CRUSHED V2 Ring</h3>
                <p class="missing-status-pill">Status: TODO (Pending 360° Render)</p>
                <p class="subtext">Expected Nuke output folder:</p>
                <code id="missingItemFolder">01_scene/nuke/comp/batch_turntable/Ring-CrushedV2/</code>
            </div>

            <div id="emptyCatalogNotice" class="empty-notice" style="display: none;">
                <h3>Waiting for Renders</h3>
                <p>No products found in <code>catalog.json</code>.</p>
                <p class="subtext">Run <code>python 05_agent/scripts/convert_turntables.py</code> after rendering in Houdini & Nuke.</p>
            </div>
        </div>

        <!-- Progress Indicator Centered Under Canvas -->
        <div class="loader-container">
            <div class="progress-bar">
                <div id="progress-fill" style="width: 0%"></div>
            </div>
            <div id="progress-text">Ready</div>
        </div>
    </div>

    <!-- Sidebar Controls -->
    <Fragment slot="controls">
        <div class="control-body elare-controls">
            <!-- Header Badge -->
            <div class="elare-sidebar-header">
                <div>
                    <h3 class="brand-title">Elaré Catalog</h3>
                    <p class="brand-subtitle" id="catalogProgressSubtitle">360° Review Hub</p>
                </div>
                <span id="product-count" class="badge">0 items</span>
            </div>

            <!-- Status / Group Filter + Category Filter Tabs -->
            <section class="control-section">
                <div class="status-filter-row" id="statusFilterTabs">
                    <button class="status-pill active" data-filter="ALL">All</button>
                    <button class="status-pill" data-filter="CURRENT">Current</button>
                    <button class="status-pill" data-filter="NEW">New</button>
                    <button class="status-pill" data-filter="FINAL">Final</button>
                    <button class="status-pill" data-filter="X3">x3 Frames</button>
                    <button class="status-pill" data-filter="TODO">Todo</button>
                </div>
                <div class="category-tabs" id="categoryTabs">
                    <button class="cat-pill active" data-category="ALL">All Categories</button>
                </div>
            </section>

            <!-- Search Input -->
            <section class="control-section">
                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input
                        type="text"
                        id="productSearch"
                        placeholder="Filter by product name, # or status..."
                        autocomplete="off"
                    />
                </div>
            </section>

            <!-- Vertical Product List (Fixed 44x44 Thumbnails + Full Name + Status Badge) -->
            <section class="control-section catalog-section">
                <div class="section-label-row">
                    <h4>Product List</h4>
                    <span id="active-product-name" class="active-piece-label">—</span>
                </div>
                <div class="product-list" id="productGrid">
                    <div class="catalog-loading">Loading catalog...</div>
                </div>
            </section>

            <!-- Render Comp Version Selector (v003 vs v002 vs v001) -->
            <section class="control-section">
                <div class="section-label-row">
                    <h4>Render Comp</h4>
                    <span id="active-version-label" class="badge-mini">v003 (1000px)</span>
                </div>
                <div class="version-toggles" id="versionToggles">
                    <button class="version-btn selected" data-version="v003" title="Latest lookdev revision (1000x1000 px)">
                        <span class="version-tag">v003</span>
                        <span class="version-sub">1000 px</span>
                    </button>
                    <button class="version-btn" data-version="v002" title="Previous high-res lookdev revision (1000x1000 px)">
                        <span class="version-tag">v002</span>
                        <span class="version-sub">1000 px</span>
                    </button>
                    <button class="version-btn" data-version="v001" title="Initial revision for visual comparison (800x800 px scaled)">
                        <span class="version-tag">v001</span>
                        <span class="version-sub">800 px</span>
                    </button>
                </div>
            </section>

            <!-- Material Variant Selector -->
            <section class="control-section">
                <div class="section-label-row">
                    <h4>Precious Metal</h4>
                    <span id="active-variant-label" class="badge-mini">Gold</span>
                </div>
                <div class="material-toggles" id="materialToggles">
                    <button class="mat-btn selected" data-material="Silver">
                        <span class="swatch-metal silver-swatch"></span>
                        <span>Silver</span>
                    </button>
                    <button class="mat-btn" data-material="Gold">
                        <span class="swatch-metal gold-swatch"></span>
                        <span>Gold</span>
                    </button>
                </div>
            </section>

            <!-- Turntable Playback Controls -->
            <section class="control-section playback-section">
                <div class="section-label-row">
                    <h4>Angle & Playback</h4>
                    <span id="angle-badge" class="badge-mini">0°</span>
                </div>
                <div class="playback-controls">
                    <button class="action-btn" id="autoplayBtn" title="Toggle continuous 360 spin">
                        <span id="autoplayIcon">▶</span>
                        <span id="autoplayText">Autoplay</span>
                    </button>
                    <button class="action-btn secondary" id="resetBtn" title="Reset angle to 0°">
                        ↺ Front
                    </button>
                </div>
            </section>

            <!-- Closed-by-Default Post-Processing / Grade Menu -->
            <details class="grade-menu" id="gradeMenu">
                <summary class="grade-menu-summary">
                    <span class="grade-summary-title">Post-Processing & Grade</span>
                    <span class="grade-summary-meta" id="gradeSummaryMeta">3% • γ 1.33 • x1.00</span>
                </summary>
                <div class="grade-menu-body">
                    <div class="grade-slider-row">
                        <div class="grade-slider-header">
                            <label for="grainSlider">Grain Amount</label>
                            <span id="grainValLabel" class="badge-mini">3%</span>
                        </div>
                        <input
                            type="range"
                            id="grainSlider"
                            min="0"
                            max="20"
                            step="1"
                            value="3"
                            title="Double-click to reset to 3%"
                        />
                    </div>

                    <div class="grade-slider-row">
                        <div class="grade-slider-header">
                            <label for="gammaSlider">Gamma</label>
                            <span id="gammaValLabel" class="badge-mini">1.33</span>
                        </div>
                        <input
                            type="range"
                            id="gammaSlider"
                            min="0.50"
                            max="2.00"
                            step="0.01"
                            value="1.33"
                            title="Double-click to reset to 1.33"
                        />
                    </div>

                    <div class="grade-slider-row">
                        <div class="grade-slider-header">
                            <label for="gainSlider">Gain</label>
                            <span id="gainValLabel" class="badge-mini">1.00</span>
                        </div>
                        <input
                            type="range"
                            id="gainSlider"
                            min="0.50"
                            max="2.00"
                            step="0.01"
                            value="1.00"
                            title="Double-click to reset to 1.00"
                        />
                    </div>

                    <div class="grade-footer-row">
                        <label class="grade-checkbox-label" title="Prevents pure #ffffff background from turning gray when Gain < 1.0">
                            <input type="checkbox" id="preserveWhiteBgCheck" checked />
                            <span>Keep #ffffff BG</span>
                        </label>
                        <button type="button" class="grade-reset-btn" id="resetGradeBtn">Reset Grade</button>
                    </div>
                </div>
            </details>
        </div>
    </Fragment>

    <!-- Top Spanning Header Slot -->
    <Fragment slot="config-description">
        <div class="hub-title-wrapper">
            <h1 class="hub-main-title">Elaré Luxury Jewelry Turntable Review Hub</h1>
        </div>
    </Fragment>
</ConfiguratorLayout>

<script>
    const CONFIG = {
        catalogUrl: "/assets/projects/elare/catalog.json",
        defaultFrames: 24,
        canvasWidth: 1000,
        canvasHeight: 1000
    };

    const state = {
        catalog: null,
        activeProduct: null,
        activeMaterial: "Gold",
        activeVersion: "v003",
        preferredVersion: "v003",
        angleIndex: 0,
        isAutoplaying: false,
        autoplayInterval: null,
        selectedCategory: "ALL",
        selectedStatusFilter: "ALL",
        searchQuery: ""
    };

    // Post-Processing & Grade Config (3% Grain, Gamma 1.33, Gain 1.00 by default)
    const grainConfig = {
        enabled: true,
        amount: 0.03,
        pixelScale: 1
    };

    const gradeConfig = {
        gamma: 1.33,
        gain: 1.0,
        preserveWhiteBg: true
    };

    const noisePatternCache = {};

    function getVFXGrainPattern(context: CanvasRenderingContext2D, frameIndex: number, amount: number, scale: number) {
        const key = `${frameIndex}_${Math.round(amount * 100)}_${scale}`;
        if (noisePatternCache[key]) return noisePatternCache[key];

        const tileSize = 256;
        const offscreen = document.createElement("canvas");
        offscreen.width = tileSize;
        offscreen.height = tileSize;
        const offCtx = offscreen.getContext("2d");
        if (!offCtx) return null;

        const imgData = offCtx.createImageData(tileSize, tileSize);
        const data = imgData.data;

        let seed = ((frameIndex + 1) * 31337) ^ 0x5DEECE66D;
        function rnd() {
            seed = (seed * 1664525 + 1013904223) >>> 0;
            return (seed & 0xFFFFFF) / 0xFFFFFF;
        }

        const amp = amount * 128;

        for (let i = 0; i < data.length; i += 4) {
            const n = (rnd() - 0.5) * 2 * amp;
            const v = Math.min(255, Math.max(0, Math.round(128 + n)));
            data[i] = v;
            data[i + 1] = v;
            data[i + 2] = v;
            data[i + 3] = 255;
        }

        offCtx.putImageData(imgData, 0, 0);
        const pattern = context.createPattern(offscreen, "repeat");
        noisePatternCache[key] = pattern;
        return pattern;
    }

    const imageCache = {};

    const canvas = document.getElementById("configCanvas") as HTMLCanvasElement;
    const ctx = canvas ? canvas.getContext("2d") : null;
    const loader = document.getElementById("loader");
    const progressFill = document.getElementById("progress-fill");
    const progressText = document.getElementById("progress-text");
    const rotateHint = document.getElementById("rotate-hint");
    const angleBadge = document.getElementById("angle-badge");
    const activeVariantLabel = document.getElementById("active-variant-label");
    const activeProductName = document.getElementById("active-product-name");
    const emptyNotice = document.getElementById("emptyCatalogNotice");
    const missingNotice = document.getElementById("missingProductNotice");
    const missingItemNum = document.getElementById("missingItemNum");
    const missingItemTitle = document.getElementById("missingItemTitle");
    const missingItemFolder = document.getElementById("missingItemFolder");
    const productGrid = document.getElementById("productGrid");
    const categoryTabs = document.getElementById("categoryTabs");
    const statusFilterTabs = document.getElementById("statusFilterTabs");
    const productCountBadge = document.getElementById("product-count");
    const catalogProgressSubtitle = document.getElementById("catalogProgressSubtitle");
    const searchInput = document.getElementById("productSearch") as HTMLInputElement;
    const autoplayBtn = document.getElementById("autoplayBtn");
    const autoplayIcon = document.getElementById("autoplayIcon");
    const autoplayText = document.getElementById("autoplayText");
    const resetBtn = document.getElementById("resetBtn");
    const materialToggles = document.getElementById("materialToggles");
    const versionToggles = document.getElementById("versionToggles");
    const activeVersionLabel = document.getElementById("active-version-label");
    const versionBadge = document.getElementById("version-badge");

    function getProductStatus(p): "todo" | "x3" | "final" {
        if (!p || p.status === "missing" || p.status === "todo") return "todo";
        if (p.status === "final" || (p.frameCount && p.frameCount >= 72)) return "final";
        return "x3";
    }

    async function initCatalog() {
        try {
            const res = await fetch(`${CONFIG.catalogUrl}?t=${Date.now()}`);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            state.catalog = await res.json();
            
            if (!state.catalog.products || state.catalog.products.length === 0) {
                showEmptyState();
                return;
            }

            if (state.catalog.defaultVersion) {
                state.activeVersion = state.catalog.defaultVersion;
                state.preferredVersion = state.catalog.defaultVersion;
            }

            updateStatusCounts();
            renderCategoryTabs();
            renderProductGrid();
            const firstReady = state.catalog.products.find(p => getProductStatus(p) !== "todo") || state.catalog.products[0];
            selectProduct(firstReady);
        } catch (err) {
            console.warn("Could not load catalog.json:", err);
            showEmptyState();
        }
    }

    function updateStatusCounts() {
        if (!state.catalog || !state.catalog.products) return;
        const products = state.catalog.products;
        const total = products.length;
        const currentCount = products.filter(p => p.group === "current").length;
        const newCount = products.filter(p => p.group === "new").length;
        const finalCount = products.filter(p => getProductStatus(p) === "final").length;
        const v3Count = products.filter(p => getProductStatus(p) !== "todo" && p.versions && p.versions.includes("v003")).length;
        const x3Count = products.filter(p => getProductStatus(p) === "x3").length;
        const todoCount = products.filter(p => getProductStatus(p) === "todo").length;

        if (catalogProgressSubtitle) {
            catalogProgressSubtitle.textContent = `${finalCount} Final (${v3Count} v003) • ${x3Count} x3 Frames • ${todoCount} Todo`;
        }

        if (statusFilterTabs) {
            const labels = {
                ALL: `All (${total})`,
                CURRENT: `Current (${currentCount})`,
                NEW: `New (${newCount})`,
                FINAL: `Final (${finalCount})`,
                X3: `x3 Frames (${x3Count})`,
                TODO: `Todo (${todoCount})`
            };
            statusFilterTabs.querySelectorAll(".status-pill").forEach((btn: HTMLElement) => {
                const key = btn.dataset.filter;
                if (key && labels[key]) btn.textContent = labels[key];
                btn.addEventListener("click", () => {
                    state.selectedStatusFilter = key || "ALL";
                    statusFilterTabs.querySelectorAll(".status-pill").forEach(b => b.classList.remove("active"));
                    btn.classList.add("active");
                    renderProductGrid();
                });
            });
        }
    }

    function showEmptyState() {
        if (loader) loader.style.display = "none";
        if (emptyNotice) emptyNotice.style.display = "flex";
        if (productGrid) {
            productGrid.innerHTML = `<div class="empty-hint"><p>No converted renders found.</p></div>`;
        }
    }

    function renderCategoryTabs() {
        if (!categoryTabs || !state.catalog) return;
        const cats = ["ALL", ...(state.catalog.categories || [])];
        categoryTabs.innerHTML = "";
        
        cats.forEach(cat => {
            const btn = document.createElement("button");
            btn.className = `cat-pill ${cat === state.selectedCategory ? "active" : ""}`;
            btn.dataset.category = cat;
            btn.textContent = cat === "ALL" ? "All Categories" : cat;
            btn.addEventListener("click", () => {
                state.selectedCategory = cat;
                document.querySelectorAll(".cat-pill").forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                renderProductGrid();
            });
            categoryTabs.appendChild(btn);
        });
    }

    function renderProductGrid() {
        if (!productGrid || !state.catalog) return;
        
        const q = state.searchQuery.toLowerCase().trim();
        const filtered = state.catalog.products.filter(p => {
            const matchesCat = state.selectedCategory === "ALL" || p.category === state.selectedCategory;
            const pStatus = getProductStatus(p);
            let matchesStatus = true;
            if (state.selectedStatusFilter === "CURRENT") matchesStatus = p.group === "current";
            else if (state.selectedStatusFilter === "NEW") matchesStatus = p.group === "new";
            else if (state.selectedStatusFilter === "FINAL") matchesStatus = pStatus === "final";
            else if (state.selectedStatusFilter === "X3") matchesStatus = pStatus === "x3";
            else if (state.selectedStatusFilter === "TODO") matchesStatus = pStatus === "todo";

            const matchesQuery = !q ||
                (p.displayName && p.displayName.toLowerCase().includes(q)) ||
                (p.name && p.name.toLowerCase().includes(q)) ||
                (p.id && p.id.toLowerCase().includes(q)) ||
                (p.num && String(p.num).toLowerCase() === q) ||
                pStatus.includes(q);
            return matchesCat && matchesStatus && matchesQuery;
        });

        if (productCountBadge) productCountBadge.textContent = `${filtered.length} piece${filtered.length === 1 ? '' : 's'}`;

        if (filtered.length === 0) {
            productGrid.innerHTML = `<div class="empty-hint"><p>No matching products</p></div>`;
            return;
        }

        productGrid.innerHTML = "";
        filtered.forEach(p => {
            const row = document.createElement("button");
            const isSelected = state.activeProduct && state.activeProduct.id === p.id;
            const pStatus = getProductStatus(p);
            const isTodo = pStatus === "todo";

            row.className = `product-list-item ${isSelected ? "active" : ""} status-${pStatus}`;
            row.dataset.id = p.id;

            const latestVer = !isTodo && p.versions && p.versions.length > 0 ? p.versions[0] : "";
            const statusBadgeHtml =
                pStatus === "final"
                    ? `<span class="status-badge badge-final">${latestVer === "v003" ? "v003 • Final" : "Final"}</span>`
                    : pStatus === "x3"
                    ? `<span class="status-badge badge-x3">x3 frames</span>`
                    : `<span class="status-badge badge-todo">todo</span>`;

            const v = state.catalog && state.catalog.updatedAt ? `?v=${state.catalog.updatedAt}` : "";
            const thumbHtml = isTodo
                ? `<div class="list-thumb todo-thumb"><span>${p.num || "—"}</span></div>`
                : `<div class="list-thumb ready-thumb"><img src="${(p.thumbnail || `${p.basePath}thumbnail.webp`)}${v}" alt="${p.displayName}" loading="lazy" /></div>`;

            const availVariants = isTodo ? [] : (p.variants || []);
            const hasSilver = availVariants.includes("Silver");
            const hasGold = availVariants.includes("Gold");

            const metalsHtml = `
                <span class="metal-chip ${hasSilver ? "metal-ready" : "metal-missing"}">
                    <span class="dot-metal silver-dot"></span>Ag
                </span>
                <span class="metal-chip ${hasGold ? "metal-ready" : "metal-missing"}">
                    <span class="dot-metal gold-dot"></span>Au
                </span>
            `;

            row.innerHTML = `
                ${thumbHtml}
                <div class="list-item-info">
                    <div class="list-item-title">${p.displayName || p.name}</div>
                    <div class="list-item-meta">
                        <span class="meta-cat">${p.category}</span>
                        <span class="meta-sep">•</span>
                        <span class="meta-metals">${metalsHtml}</span>
                    </div>
                </div>
                <div class="list-item-status">
                    ${statusBadgeHtml}
                </div>
            `;

            row.addEventListener("click", () => {
                selectProduct(p);
                document.querySelectorAll(".product-list-item").forEach(c => c.classList.remove("active"));
                row.classList.add("active");
            });

            productGrid.appendChild(row);
        });
    }

    if (searchInput) {
        searchInput.addEventListener("input", (e) => {
            state.searchQuery = (e.target as HTMLInputElement).value;
            renderProductGrid();
        });
    }

    function selectProduct(product) {
        state.activeProduct = product;
        
        if (activeProductName) {
            activeProductName.textContent = product.displayName;
        }

        const pStatus = getProductStatus(product);
        if (pStatus === "todo") {
            stopAutoplay();
            if (loader) loader.style.display = "none";
            if (versionBadge) versionBadge.style.display = "none";
            if (missingNotice) {
                missingNotice.style.display = "flex";
                if (missingItemNum) missingItemNum.textContent = product.num ? `#${product.num}` : "TODO";
                if (missingItemTitle) missingItemTitle.textContent = product.displayName;
                if (missingItemFolder) {
                    missingItemFolder.textContent = `01_scene/nuke/comp/batch_turntable/${product.id}/`;
                }
            }
            if (ctx && canvas) {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
            }
            if (progressFill) progressFill.style.width = "0%";
            if (progressText) progressText.textContent = "Status: TODO (Pending Render)";
            return;
        }

        if (missingNotice) missingNotice.style.display = "none";
        if (versionBadge) versionBadge.style.display = "block";

        const total = product.frameCount || CONFIG.defaultFrames;
        if (state.angleIndex >= total) {
            state.angleIndex = 0;
        }

        const availVersions = product.versions || ["v003", "v002", "v001"];
        if (availVersions.includes(state.preferredVersion)) {
            state.activeVersion = state.preferredVersion;
        } else if (!availVersions.includes(state.activeVersion)) {
            state.activeVersion = product.defaultVersion || availVersions[0] || "v002";
        }

        if (!product.variants.includes(state.activeMaterial)) {
            state.activeMaterial = product.defaultVariant || product.variants[0] || "Gold";
        }

        updateVersionButtons();
        updateMaterialButtons();
        updateAngleReadout();
        loadAndRenderCurrent();
        
        const otherVariant = product.variants.find(v => v !== state.activeMaterial);
        if (otherVariant) {
            preloadVariant(product, otherVariant, state.activeVersion);
        }
    }

    function updateVersionButtons() {
        if (!versionToggles || !state.activeProduct) return;
        const available = state.activeProduct.versions || ["v003", "v002", "v001"];

        versionToggles.querySelectorAll(".version-btn").forEach((btn: HTMLElement) => {
            const ver = btn.dataset.version;
            const isAvail = available.includes(ver);
            const isSelected = ver === state.activeVersion;

            btn.classList.toggle("disabled", !isAvail);
            btn.classList.toggle("selected", isSelected);
            (btn as HTMLButtonElement).disabled = !isAvail;
        });

        const resMap = (state.activeProduct && state.activeProduct.resolutions) || { v001: 800, v002: 1000, v003: 1000 };
        const curRes = resMap[state.activeVersion] || (state.activeVersion === "v001" ? 800 : 1000);

        if (activeVersionLabel) {
            activeVersionLabel.textContent = `${state.activeVersion} (${curRes}px)`;
        }
        if (versionBadge) {
            const scaleTag = state.activeVersion === "v001" ? " (scaled)" : "";
            versionBadge.textContent = `${state.activeVersion} • ${curRes}px${scaleTag}`;
        }
    }

    if (versionToggles) {
        versionToggles.querySelectorAll(".version-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                const ver = (btn as HTMLElement).dataset.version;
                if (!ver || ver === state.activeVersion) return;
                const available = (state.activeProduct && state.activeProduct.versions) || ["v003", "v002", "v001"];
                if (!available.includes(ver)) return;
                state.activeVersion = ver;
                state.preferredVersion = ver;
                updateVersionButtons();
                loadAndRenderCurrent();
                if (state.activeProduct) {
                    const other = state.activeProduct.variants.find(v => v !== state.activeMaterial);
                    if (other) preloadVariant(state.activeProduct, other, state.activeVersion);
                }
            });
        });
    }

    function updateMaterialButtons() {
        if (!materialToggles || !state.activeProduct) return;
        const available = state.activeProduct.variants || ["Silver", "Gold"];
        
        materialToggles.querySelectorAll(".mat-btn").forEach((btn: HTMLElement) => {
            const mat = btn.dataset.material;
            const isAvail = available.includes(mat);
            const isSelected = mat === state.activeMaterial;

            btn.classList.toggle("disabled", !isAvail);
            btn.classList.toggle("selected", isSelected);
            (btn as HTMLButtonElement).disabled = !isAvail;
        });

        if (activeVariantLabel) {
            activeVariantLabel.textContent = state.activeMaterial;
        }
    }

    if (materialToggles) {
        materialToggles.querySelectorAll(".mat-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                const mat = (btn as HTMLElement).dataset.material;
                if (!mat || !state.activeProduct || !state.activeProduct.variants.includes(mat)) return;
                state.activeMaterial = mat;
                updateMaterialButtons();
                loadAndRenderCurrent();
            });
        });
    }

    function getFrameUrl(product, material, index, version = state.activeVersion) {
        const framePad = String(index).padStart(2, "0");
        const basePath = product ? product.basePath : "";
        const v = state.catalog && state.catalog.updatedAt ? `?v=${state.catalog.updatedAt}` : "";
        const hasVersion = product && product.versions && product.versions.includes(version);
        const verPrefix = hasVersion ? `${version}/` : "";
        return `${basePath}${verPrefix}${material}/frame_${framePad}.webp${v}`;
    }

    function drawCurrentFrame() {
        if (!ctx || !canvas || !state.activeProduct || getProductStatus(state.activeProduct) === "todo") return;
        const url = getFrameUrl(state.activeProduct, state.activeMaterial, state.angleIndex);
        const img = imageCache[url];

        if (img && img.complete && img.naturalWidth > 0) {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = "high";
            
            // 1. Draw base photo-real render directly (scales 800px frames to fit 1000px viewer smoothly)
            ctx.globalCompositeOperation = "source-over";
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

            // 2. Apply VFX Film Grain in overlay mode (leaves pure #ffffff background at 255,255,255)
            if (grainConfig.enabled && grainConfig.amount > 0) {
                const pattern = getVFXGrainPattern(ctx, state.angleIndex, grainConfig.amount, grainConfig.pixelScale);
                if (pattern) {
                    ctx.save();
                    ctx.globalCompositeOperation = "overlay";
                    ctx.fillStyle = pattern;
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    ctx.globalCompositeOperation = "destination-in";
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    ctx.restore();
                }
            }

            if (loader) loader.style.display = "none";
        }
        updateAngleReadout();
    }

    function updateAngleReadout() {
        if (angleBadge) {
            const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
            const deg = Math.round(state.angleIndex * (360 / total));
            angleBadge.textContent = `${deg}°`;
        }
    }

    let loadSequenceId = 0;

    function loadAndRenderCurrent() {
        if (!state.activeProduct || getProductStatus(state.activeProduct) === "todo") return;
        const currentSeq = ++loadSequenceId;
        const total = state.activeProduct.frameCount || CONFIG.defaultFrames;
        const statusLabel = total >= 72 ? "Final" : "x3 frames";
        const verTag = state.activeVersion.toUpperCase();
        const resMap = (state.activeProduct && state.activeProduct.resolutions) || { v001: 800, v002: 1000, v003: 1000 };
        const curRes = resMap[state.activeVersion] || (state.activeVersion === "v001" ? 800 : 1000);
        const scaleTag = state.activeVersion === "v001" ? " scaled" : "";
        let loadedCount = 0;

        const targetUrl = getFrameUrl(state.activeProduct, state.activeMaterial, state.angleIndex);
        if (!imageCache[targetUrl]) {
            if (loader) loader.style.display = "flex";
        }

        loadImage(targetUrl).then(() => {
            if (currentSeq === loadSequenceId) {
                drawCurrentFrame();
            }
        });

        for (let i = 0; i < total; i++) {
            const url = getFrameUrl(state.activeProduct, state.activeMaterial, i);
            loadImage(url).then(() => {
                if (currentSeq !== loadSequenceId) return;
                loadedCount++;
                const pct = Math.round((loadedCount / total) * 100);
                if (progressFill) progressFill.style.width = `${pct}%`;
                if (progressText) progressText.textContent = `${loadedCount} / ${total} frames (${statusLabel} • ${Math.round(360 / total)}° step • ${verTag} ${curRes}px${scaleTag})`;

                if (loadedCount >= total) {
                    if (loader) loader.style.display = "none";
                    drawCurrentFrame();
                }
            });
        }
    }

    function preloadVariant(product, material, version = state.activeVersion) {
        if (!product || getProductStatus(product) === "todo") return;
        const total = product.frameCount || CONFIG.defaultFrames;
        for (let i = 0; i < total; i++) {
            const url = getFrameUrl(product, material, i, version);
            loadImage(url);
        }
    }

    function loadImage(url: string): Promise<HTMLImageElement> {
        if (imageCache[url]) {
            return Promise.resolve(imageCache[url]);
        }
        return new Promise((resolve) => {
            const img = new Image();
            img.src = url;
            img.onload = () => {
                imageCache[url] = img;
                resolve(img);
            };
            img.onerror = () => {
                resolve(img);
            };
        });
    }

    function getDragSensitivity() {
        const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
        return total >= 72 ? 9 : 16;
    }

    let isDragging = false;
    let startX = 0;

    if (typeof window !== "undefined" && (window.matchMedia("(pointer: coarse)").matches || "ontouchstart" in window)) {
        const hintText = document.querySelector("#rotate-hint .hint-text");
        if (hintText) {
            hintText.textContent = "Swipe to rotate • Space for autoplay";
        }
    }

    if (canvas) {
        canvas.addEventListener("mousedown", (e) => {
            if (!state.activeProduct || getProductStatus(state.activeProduct) === "todo") return;
            isDragging = true;
            startX = e.clientX;
            stopAutoplay();
            if (rotateHint) rotateHint.style.opacity = "0";
        });

        window.addEventListener("mousemove", (e) => {
            if (!isDragging) return;
            const dx = e.clientX - startX;
            const sensitivity = getDragSensitivity();
            if (Math.abs(dx) >= sensitivity) {
                const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
                const steps = Math.floor(dx / sensitivity);
                state.angleIndex = (state.angleIndex + steps + total * 10) % total;
                startX = e.clientX;
                drawCurrentFrame();
            }
        });

        window.addEventListener("mouseup", () => {
            isDragging = false;
        });

        canvas.addEventListener("touchstart", (e) => {
            if (!state.activeProduct || getProductStatus(state.activeProduct) === "todo") return;
            if (e.touches.length === 1) {
                isDragging = true;
                startX = e.touches[0].clientX;
                stopAutoplay();
                if (rotateHint) rotateHint.style.opacity = "0";
            }
        }, { passive: true });

        window.addEventListener("touchmove", (e) => {
            if (!isDragging || e.touches.length !== 1) return;
            const dx = e.touches[0].clientX - startX;
            const sensitivity = getDragSensitivity();
            if (Math.abs(dx) >= sensitivity) {
                const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
                const steps = Math.floor(dx / sensitivity);
                state.angleIndex = (state.angleIndex + steps + total * 10) % total;
                startX = e.touches[0].clientX;
                drawCurrentFrame();
            }
        }, { passive: true });

        window.addEventListener("touchend", () => {
            isDragging = false;
        });

        window.addEventListener("touchcancel", () => {
            isDragging = false;
        });
    }

    function toggleAutoplay() {
        if (!state.activeProduct || getProductStatus(state.activeProduct) === "todo") return;
        if (state.isAutoplaying) {
            stopAutoplay();
        } else {
            startAutoplay();
        }
    }

    function startAutoplay() {
        if (state.isAutoplaying) return;
        state.isAutoplaying = true;
        if (autoplayBtn) autoplayBtn.classList.add("playing");
        if (autoplayIcon) autoplayIcon.textContent = "⏸";
        if (autoplayText) autoplayText.textContent = "Pause";
        if (rotateHint) rotateHint.style.opacity = "0";

        const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
        const intervalMs = total >= 72 ? 42 : 95;

        state.autoplayInterval = setInterval(() => {
            const frameTotal = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
            state.angleIndex = (state.angleIndex + 1) % frameTotal;
            drawCurrentFrame();
        }, intervalMs);
    }

    function stopAutoplay() {
        if (!state.isAutoplaying) return;
        state.isAutoplaying = false;
        if (autoplayBtn) autoplayBtn.classList.remove("playing");
        if (autoplayIcon) autoplayIcon.textContent = "▶";
        if (autoplayText) autoplayText.textContent = "Autoplay";
        if (state.autoplayInterval) {
            clearInterval(state.autoplayInterval);
            state.autoplayInterval = null;
        }
    }

    if (autoplayBtn) {
        autoplayBtn.addEventListener("click", toggleAutoplay);
    }

    if (resetBtn) {
        resetBtn.addEventListener("click", () => {
            stopAutoplay();
            state.angleIndex = 0;
            drawCurrentFrame();
        });
    }

    // --- Post-Processing & Grade Controls (Grain 0-20%, Gamma, Gain) ---
    const grainSlider = document.getElementById("grainSlider") as HTMLInputElement;
    const gammaSlider = document.getElementById("gammaSlider") as HTMLInputElement;
    const gainSlider = document.getElementById("gainSlider") as HTMLInputElement;
    const grainValLabel = document.getElementById("grainValLabel");
    const gammaValLabel = document.getElementById("gammaValLabel");
    const gainValLabel = document.getElementById("gainValLabel");
    const gradeSummaryMeta = document.getElementById("gradeSummaryMeta");
    const preserveWhiteBgCheck = document.getElementById("preserveWhiteBgCheck") as HTMLInputElement;
    const resetGradeBtn = document.getElementById("resetGradeBtn");
    const gradeFuncR = document.getElementById("gradeFuncR");
    const gradeFuncG = document.getElementById("gradeFuncG");
    const gradeFuncB = document.getElementById("gradeFuncB");

    function updateGradeFilter() {
        const grainPct = Math.round(grainConfig.amount * 100);
        if (grainValLabel) grainValLabel.textContent = `${grainPct}%`;
        if (gammaValLabel) gammaValLabel.textContent = gradeConfig.gamma.toFixed(2);
        if (gainValLabel) gainValLabel.textContent = gradeConfig.gain.toFixed(2);
        if (gradeSummaryMeta) {
            gradeSummaryMeta.textContent = `${grainPct}% • γ ${gradeConfig.gamma.toFixed(2)} • x${gradeConfig.gain.toFixed(2)}`;
        }

        if (!canvas || !gradeFuncR || !gradeFuncG || !gradeFuncB) return;

        const isIdentity = Math.abs(gradeConfig.gamma - 1.0) < 0.001 && Math.abs(gradeConfig.gain - 1.0) < 0.001;
        if (isIdentity) {
            gradeFuncR.setAttribute("type", "identity");
            gradeFuncG.setAttribute("type", "identity");
            gradeFuncB.setAttribute("type", "identity");
            canvas.style.filter = "none";
            return;
        }

        // Build 256-entry Nuke Grade LUT: out = (in * gain) ^ (1 / gamma)
        const invGamma = 1.0 / Math.max(0.05, gradeConfig.gamma);
        const gain = gradeConfig.gain;
        const keepWhite = gradeConfig.preserveWhiteBg;
        const table: string[] = [];

        for (let i = 0; i < 256; i++) {
            const x = i / 255.0;
            let y = Math.pow(Math.max(0.0, x * gain), invGamma);

            // Smoothly feather top 4% back to 1.0 so #ffffff background never turns gray when Gain < 1.0
            if (keepWhite && x > 0.96) {
                const t = (x - 0.96) / 0.04;
                const s = t * t * (3.0 - 2.0 * t);
                y = y * (1.0 - s) + 1.0 * s;
            }

            y = Math.min(1.0, Math.max(0.0, y));
            table.push(y.toFixed(4));
        }

        const tableStr = table.join(" ");
        gradeFuncR.setAttribute("type", "table");
        gradeFuncG.setAttribute("type", "table");
        gradeFuncB.setAttribute("type", "table");
        gradeFuncR.setAttribute("tableValues", tableStr);
        gradeFuncG.setAttribute("tableValues", tableStr);
        gradeFuncB.setAttribute("tableValues", tableStr);
        canvas.style.filter = "url(#elareGradeFilter)";
    }

    if (grainSlider) {
        grainSlider.addEventListener("input", () => {
            const pct = parseFloat(grainSlider.value) || 0;
            grainConfig.amount = pct / 100.0;
            grainConfig.enabled = pct > 0;
            updateGradeFilter();
            drawCurrentFrame();
        });
        grainSlider.addEventListener("dblclick", () => {
            grainSlider.value = "3";
            grainConfig.amount = 0.03;
            grainConfig.enabled = true;
            updateGradeFilter();
            drawCurrentFrame();
        });
    }

    if (gammaSlider) {
        gammaSlider.addEventListener("input", () => {
            gradeConfig.gamma = parseFloat(gammaSlider.value) || 1.33;
            updateGradeFilter();
        });
        gammaSlider.addEventListener("dblclick", () => {
            gammaSlider.value = "1.33";
            gradeConfig.gamma = 1.33;
            updateGradeFilter();
        });
    }

    if (gainSlider) {
        gainSlider.addEventListener("input", () => {
            gradeConfig.gain = parseFloat(gainSlider.value) || 1.0;
            updateGradeFilter();
        });
        gainSlider.addEventListener("dblclick", () => {
            gainSlider.value = "1.00";
            gradeConfig.gain = 1.0;
            updateGradeFilter();
        });
    }

    if (preserveWhiteBgCheck) {
        preserveWhiteBgCheck.addEventListener("change", () => {
            gradeConfig.preserveWhiteBg = preserveWhiteBgCheck.checked;
            updateGradeFilter();
        });
    }

    if (resetGradeBtn) {
        resetGradeBtn.addEventListener("click", () => {
            grainConfig.amount = 0.03;
            grainConfig.enabled = true;
            gradeConfig.gamma = 1.33;
            gradeConfig.gain = 1.0;
            gradeConfig.preserveWhiteBg = true;
            if (grainSlider) grainSlider.value = "3";
            if (gammaSlider) gammaSlider.value = "1.33";
            if (gainSlider) gainSlider.value = "1.00";
            if (preserveWhiteBgCheck) preserveWhiteBgCheck.checked = true;
            updateGradeFilter();
            drawCurrentFrame();
        });
    }

    updateGradeFilter();

    window.addEventListener("keydown", (e) => {
        if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
        const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
        if (e.code === "Space") {
            e.preventDefault();
            toggleAutoplay();
        } else if (e.code === "ArrowLeft") {
            state.angleIndex = (state.angleIndex - 1 + total) % total;
            drawCurrentFrame();
        } else if (e.code === "ArrowRight") {
            state.angleIndex = (state.angleIndex + 1) % total;
            drawCurrentFrame();
        }
    });

    initCatalog();
</script>

