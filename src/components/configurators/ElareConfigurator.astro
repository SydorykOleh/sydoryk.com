---
import ConfiguratorLayout from "../../layouts/ConfiguratorLayout.astro";
---

<ConfiguratorLayout
    title="Elaré Jewelry 360 Turntable Review"
    description="Interactive 360-degree turntable review system for Elaré luxury jewelry catalog."
    keywords="Jewelry, 360 Rotation, Turntable, Product Viewer, Pre-rendered, WebP, Elare"
>
    <!-- Viewport Stage (Canvas + Overlay + Loader) -->
    <div class="turntable-stage">
        <div class="canvas-wrapper">
            <canvas id="configCanvas" width="800" height="800"></canvas>
            
            <div id="rotate-hint">
                <span class="mouse-icon">🖱️</span>
                <span class="hint-text">Drag to rotate • Space for autoplay</span>
            </div>

            <div id="loader">Loading Turntable...</div>

            <div id="emptyCatalogNotice" class="empty-notice" style="display: none;">
                <h3>Waiting for Renders</h3>
                <p>No products found in <code>catalog.json</code>.</p>
                <p class="subtext">Run <code>python convert_turntables.py</code> after rendering in Houdini & Nuke.</p>
            </div>
        </div>

        <!-- Progress Indicator Centered Under Canvas -->
        <div class="loader-container">
            <div class="progress-bar">
                <div id="progress-fill" style="width: 0%"></div>
            </div>
            <div id="progress-text">Ready</div>
        </div>
    </div>

    <!-- Sidebar Controls -->
    <Fragment slot="controls">
        <div class="control-body elare-controls">
            <!-- Header Badge -->
            <div class="elare-sidebar-header">
                <div>
                    <h3 class="brand-title">Elaré Catalog</h3>
                    <p class="brand-subtitle">360° Review Hub</p>
                </div>
                <span id="product-count" class="badge">0 items</span>
            </div>

            <!-- Side-by-Side Comparison Shortcut -->
            <div class="compare-banner-box">
                <a href="/mockups/elare-compare.html" target="_blank" class="compare-banner-link">
                    <span>⇄ Compare Normal vs Dark (Side-by-Side)</span>
                    <span style="font-size: 13px;">↗</span>
                </a>
            </div>

            <!-- Category Filter Tabs -->
            <section class="control-section">
                <div class="category-tabs" id="categoryTabs">
                    <button class="cat-pill active" data-category="ALL">All</button>
                </div>
            </section>

            <!-- Search Input -->
            <section class="control-section">
                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input
                        type="text"
                        id="productSearch"
                        placeholder="Filter by name..."
                        autocomplete="off"
                    />
                </div>
            </section>

            <!-- Compact Product Thumbnails Grid (Designed for 40-50 products) -->
            <section class="control-section catalog-section">
                <div class="section-label-row">
                    <h4>Select Piece</h4>
                    <span id="active-product-name" class="active-piece-label">—</span>
                </div>
                <div class="compact-product-grid" id="productGrid">
                    <div class="catalog-loading">Loading catalog...</div>
                </div>
            </section>

            <!-- Material Variant Selector -->
            <section class="control-section">
                <div class="section-label-row">
                    <h4>Precious Metal</h4>
                    <span id="active-variant-label" class="badge-mini">Silver</span>
                </div>
                <div class="material-toggles" id="materialToggles">
                    <button class="mat-btn selected" data-material="Silver">
                        <span class="swatch-metal silver-swatch"></span>
                        <span>Silver</span>
                    </button>
                    <button class="mat-btn" data-material="Gold">
                        <span class="swatch-metal gold-swatch"></span>
                        <span>Gold</span>
                    </button>
                </div>
            </section>

            <!-- Turntable Playback Controls -->
            <section class="control-section playback-section">
                <div class="section-label-row">
                    <h4>Angle & Playback</h4>
                    <span id="angle-badge" class="badge-mini">0°</span>
                </div>
                <div class="playback-controls">
                    <button class="action-btn" id="autoplayBtn" title="Toggle continuous 360 spin">
                        <span id="autoplayIcon">▶</span>
                        <span id="autoplayText">Autoplay</span>
                    </button>
                    <button class="action-btn secondary" id="resetBtn" title="Reset angle to 0°">
                        ↺ Front
                    </button>
                </div>
            </section>
        </div>
    </Fragment>

    <!-- Top Spanning Header Slot (Row 1 across both columns, zero description) -->
    <Fragment slot="config-description">
        <div class="hub-title-wrapper">
            <h1 class="hub-main-title">Elaré Luxury Jewelry Turntable Review Hub</h1>
        </div>
    </Fragment>
</ConfiguratorLayout>

<script>
    const CONFIG = {
        catalogUrl: "/assets/projects/elare/catalog.json",
        defaultFrames: 72,
        canvasWidth: 800,
        canvasHeight: 800
    };

    const state = {
        catalog: null,
        activeProduct: null,
        activeMaterial: "Silver",
        angleIndex: 0,
        isAutoplaying: false,
        autoplayInterval: null,
        selectedCategory: "ALL",
        searchQuery: ""
    };

    // VFX Mathematical Film Grain State
    const grainConfig = {
        enabled: true,
        amount: 0.07, // Locked-in optimal setting: Fine 1px micro-grain at 7%
        pixelScale: 1
    };

    const noisePatternCache = {};

    function getVFXGrainPattern(context: CanvasRenderingContext2D, frameIndex: number, amount: number, scale: number) {
        const key = `${frameIndex}_${Math.round(amount * 100)}_${scale}`;
        if (noisePatternCache[key]) return noisePatternCache[key];

        const tileSize = 256;
        const offscreen = document.createElement("canvas");
        offscreen.width = tileSize;
        offscreen.height = tileSize;
        const offCtx = offscreen.getContext("2d");
        if (!offCtx) return null;

        const imgData = offCtx.createImageData(tileSize, tileSize);
        const data = imgData.data;

        // Seeded pseudo-random generator per frame angle
        let seed = ((frameIndex + 1) * 31337) ^ 0x5DEECE66D;
        function rnd() {
            seed = (seed * 1664525 + 1013904223) >>> 0;
            return (seed & 0xFFFFFF) / 0xFFFFFF;
        }

        const amp = amount * 128;

        if (scale === 1) {
            for (let i = 0; i < data.length; i += 4) {
                const n = (rnd() - 0.5) * 2 * amp;
                const v = Math.min(255, Math.max(0, Math.round(128 + n)));
                data[i] = v;
                data[i + 1] = v;
                data[i + 2] = v;
                data[i + 3] = 255;
            }
        } else {
            for (let y = 0; y < tileSize; y += scale) {
                for (let x = 0; x < tileSize; x += scale) {
                    const n = (rnd() - 0.5) * 2 * amp;
                    const v = Math.min(255, Math.max(0, Math.round(128 + n)));
                    for (let dy = 0; dy < scale && (y + dy) < tileSize; dy++) {
                        for (let dx = 0; dx < scale && (x + dx) < tileSize; dx++) {
                            const idx = ((y + dy) * tileSize + (x + dx)) * 4;
                            data[idx] = v;
                            data[idx + 1] = v;
                            data[idx + 2] = v;
                            data[idx + 3] = 255;
                        }
                    }
                }
            }
        }

        offCtx.putImageData(imgData, 0, 0);
        const pattern = context.createPattern(offscreen, "repeat");
        noisePatternCache[key] = pattern;
        return pattern;
    }

    const imageCache = {};

    const canvas = document.getElementById("configCanvas") as HTMLCanvasElement;
    const ctx = canvas ? canvas.getContext("2d") : null;
    const loader = document.getElementById("loader");
    const progressFill = document.getElementById("progress-fill");
    const progressText = document.getElementById("progress-text");
    const rotateHint = document.getElementById("rotate-hint");
    const angleBadge = document.getElementById("angle-badge");
    const activeVariantLabel = document.getElementById("active-variant-label");
    const activeProductName = document.getElementById("active-product-name");
    const emptyNotice = document.getElementById("emptyCatalogNotice");
    const productGrid = document.getElementById("productGrid");
    const categoryTabs = document.getElementById("categoryTabs");
    const productCountBadge = document.getElementById("product-count");
    const searchInput = document.getElementById("productSearch") as HTMLInputElement;
    const autoplayBtn = document.getElementById("autoplayBtn");
    const autoplayIcon = document.getElementById("autoplayIcon");
    const autoplayText = document.getElementById("autoplayText");
    const resetBtn = document.getElementById("resetBtn");
    const materialToggles = document.getElementById("materialToggles");

    async function initCatalog() {
        try {
            const res = await fetch(`${CONFIG.catalogUrl}?t=${Date.now()}`);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            state.catalog = await res.json();
            
            if (!state.catalog.products || state.catalog.products.length === 0) {
                showEmptyState();
                return;
            }

            renderCategoryTabs();
            renderProductGrid();
            selectProduct(state.catalog.products[0]);
        } catch (err) {
            console.warn("Could not load catalog.json:", err);
            showEmptyState();
        }
    }

    function showEmptyState() {
        if (loader) loader.style.display = "none";
        if (emptyNotice) emptyNotice.style.display = "flex";
        if (productGrid) {
            productGrid.innerHTML = `<div class="empty-hint"><p>No converted renders found.</p></div>`;
        }
    }

    function renderCategoryTabs() {
        if (!categoryTabs || !state.catalog) return;
        const cats = ["ALL", ...(state.catalog.categories || [])];
        categoryTabs.innerHTML = "";
        
        cats.forEach(cat => {
            const btn = document.createElement("button");
            btn.className = `cat-pill ${cat === state.selectedCategory ? "active" : ""}`;
            btn.dataset.category = cat;
            btn.textContent = cat === "ALL" ? "All" : cat;
            btn.addEventListener("click", () => {
                state.selectedCategory = cat;
                document.querySelectorAll(".cat-pill").forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                renderProductGrid();
            });
            categoryTabs.appendChild(btn);
        });
    }

    function renderProductGrid() {
        if (!productGrid || !state.catalog) return;
        
        const q = state.searchQuery.toLowerCase().trim();
        const filtered = state.catalog.products.filter(p => {
            const matchesCat = state.selectedCategory === "ALL" || p.category === state.selectedCategory;
            const matchesQuery = !q || p.displayName.toLowerCase().includes(q) || p.id.toLowerCase().includes(q);
            return matchesCat && matchesQuery;
        });

        if (productCountBadge) productCountBadge.textContent = `${filtered.length} piece${filtered.length === 1 ? '' : 's'}`;

        if (filtered.length === 0) {
            productGrid.innerHTML = `<div class="empty-hint"><p>No matches</p></div>`;
            return;
        }

        productGrid.innerHTML = "";
        filtered.forEach(p => {
            const card = document.createElement("button");
            const isSelected = state.activeProduct && state.activeProduct.id === p.id;
            card.className = `compact-card ${isSelected ? "active" : ""}`;
            card.dataset.id = p.id;
            card.title = p.displayName;
            
            const thumbUrl = p.thumbnail || `${p.basePath}thumbnail.webp`;
            
            const dotsHtml = (p.variants || []).map(v => 
                `<span class="dot-variant ${v.toLowerCase()}"></span>`
            ).join("");

            card.innerHTML = `
                <div class="card-thumb-wrapper">
                    <img src="${thumbUrl}" alt="${p.displayName}" loading="lazy" onerror="this.src='/favicon.png'"/>
                    <div class="dot-indicators">${dotsHtml}</div>
                </div>
                <div class="card-caption">${p.name || p.displayName}</div>
            `;

            card.addEventListener("click", () => {
                selectProduct(p);
                document.querySelectorAll(".compact-card").forEach(c => c.classList.remove("active"));
                card.classList.add("active");
            });

            productGrid.appendChild(card);
        });
    }

    if (searchInput) {
        searchInput.addEventListener("input", (e) => {
            state.searchQuery = (e.target as HTMLInputElement).value;
            renderProductGrid();
        });
    }

    function selectProduct(product) {
        state.activeProduct = product;
        
        if (activeProductName) {
            activeProductName.textContent = product.displayName;
        }

        if (!product.variants.includes(state.activeMaterial)) {
            state.activeMaterial = product.defaultVariant || product.variants[0] || "Silver";
        }

        updateMaterialButtons();
        updateAngleReadout();
        loadAndRenderCurrent();
        
        const otherVariant = product.variants.find(v => v !== state.activeMaterial);
        if (otherVariant) {
            preloadVariant(product, otherVariant);
        }
    }

    function updateMaterialButtons() {
        if (!materialToggles || !state.activeProduct) return;
        const available = state.activeProduct.variants || ["Silver", "Gold"];
        
        materialToggles.querySelectorAll(".mat-btn").forEach((btn: HTMLElement) => {
            const mat = btn.dataset.material;
            const isAvail = available.includes(mat);
            const isSelected = mat === state.activeMaterial;

            btn.classList.toggle("disabled", !isAvail);
            btn.classList.toggle("selected", isSelected);
            (btn as HTMLButtonElement).disabled = !isAvail;
        });

        if (activeVariantLabel) {
            activeVariantLabel.textContent = state.activeMaterial;
        }
    }

    if (materialToggles) {
        materialToggles.querySelectorAll(".mat-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                const mat = (btn as HTMLElement).dataset.material;
                if (!mat || !state.activeProduct || !state.activeProduct.variants.includes(mat)) return;
                state.activeMaterial = mat;
                updateMaterialButtons();
                loadAndRenderCurrent();
            });
        });
    }

    function getFrameUrl(product, material, index) {
        const framePad = String(index).padStart(2, "0");
        return `${product.basePath}${material}/frame_${framePad}.webp`;
    }

    function drawCurrentFrame() {
        if (!ctx || !canvas || !state.activeProduct) return;
        const url = getFrameUrl(state.activeProduct, state.activeMaterial, state.angleIndex);
        const img = imageCache[url];

        if (img && img.complete && img.naturalWidth > 0) {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // 1. Draw base photo-real render
            ctx.globalCompositeOperation = "source-over";
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

            // 2. Apply VFX Film Grain: Multiplied overlay centered exactly at 1.0 (neutral 128)
            // Masked with destination-in so transparent backgrounds remain 100% transparent
            if (grainConfig.enabled && grainConfig.amount > 0) {
                const pattern = getVFXGrainPattern(ctx, state.angleIndex, grainConfig.amount, grainConfig.pixelScale);
                if (pattern) {
                    ctx.save();
                    ctx.globalCompositeOperation = "overlay";
                    ctx.fillStyle = pattern;
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    ctx.globalCompositeOperation = "destination-in";
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    ctx.restore();
                }
            }

            if (loader) loader.style.display = "none";
        }
        updateAngleReadout();
    }

    function updateAngleReadout() {
        if (angleBadge) {
            const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
            const deg = Math.round(state.angleIndex * (360 / total));
            angleBadge.textContent = `${deg}°`;
        }
    }

    let loadSequenceId = 0;
    function loadAndRenderCurrent() {
        if (!state.activeProduct) return;
        const currentSeq = ++loadSequenceId;
        const total = state.activeProduct.frameCount || CONFIG.defaultFrames;
        let loadedCount = 0;

        if (loader) {
            loader.style.display = "flex";
            loader.textContent = `Loading ${state.activeProduct.name || state.activeProduct.displayName}...`;
        }
        if (progressFill) progressFill.style.width = "0%";
        if (progressText) progressText.textContent = `0 / ${total}`;

        const currentUrl = getFrameUrl(state.activeProduct, state.activeMaterial, state.angleIndex);
        loadImage(currentUrl).then(() => {
            if (currentSeq === loadSequenceId) {
                drawCurrentFrame();
            }
        });

        for (let i = 0; i < total; i++) {
            const url = getFrameUrl(state.activeProduct, state.activeMaterial, i);
            loadImage(url).then(() => {
                if (currentSeq !== loadSequenceId) return;
                loadedCount++;
                const pct = Math.round((loadedCount / total) * 100);
                if (progressFill) progressFill.style.width = `${pct}%`;
                if (progressText) progressText.textContent = `${loadedCount} / ${total}`;

                if (loadedCount >= total) {
                    if (loader) loader.style.display = "none";
                    drawCurrentFrame();
                }
            });
        }
    }

    function preloadVariant(product, material) {
        const total = product.frameCount || CONFIG.defaultFrames;
        for (let i = 0; i < total; i++) {
            const url = getFrameUrl(product, material, i);
            loadImage(url);
        }
    }

    function loadImage(url: string): Promise<HTMLImageElement> {
        if (imageCache[url]) {
            return Promise.resolve(imageCache[url]);
        }
        return new Promise((resolve) => {
            const img = new Image();
            img.src = url;
            img.onload = () => {
                imageCache[url] = img;
                resolve(img);
            };
            img.onerror = () => {
                resolve(img);
            };
        });
    }

    // Dynamic rotation sensitivity: 9px for 72 frames (5° step), 18px for 36 frames (10° step) (+30% faster rotation)
    function getDragSensitivity() {
        const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
        return total >= 72 ? 9 : 18;
    }

    // Natural drag to rotate (follows cursor & touch gestures)
    let isDragging = false;
    let startX = 0;

    // Mobile / touch hint adaptation
    if (typeof window !== "undefined" && (window.matchMedia("(pointer: coarse)").matches || "ontouchstart" in window)) {
        const hintText = document.querySelector("#rotate-hint .hint-text");
        if (hintText) {
            hintText.textContent = "Swipe to rotate • Space for autoplay";
        }
    }

    if (canvas) {
        canvas.addEventListener("mousedown", (e) => {
            isDragging = true;
            startX = e.clientX;
            stopAutoplay();
            if (rotateHint) rotateHint.style.opacity = "0";
        });

        window.addEventListener("mousemove", (e) => {
            if (!isDragging) return;
            const dx = e.clientX - startX;
            const sensitivity = getDragSensitivity();
            if (Math.abs(dx) >= sensitivity) {
                const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
                const steps = Math.floor(dx / sensitivity);
                state.angleIndex = (state.angleIndex + steps + total * 10) % total;
                startX = e.clientX;
                drawCurrentFrame();
            }
        });

        window.addEventListener("mouseup", () => {
            isDragging = false;
        });

        canvas.addEventListener("touchstart", (e) => {
            if (e.touches.length === 1) {
                isDragging = true;
                startX = e.touches[0].clientX;
                stopAutoplay();
                if (rotateHint) rotateHint.style.opacity = "0";
            }
        }, { passive: true });

        window.addEventListener("touchmove", (e) => {
            if (!isDragging || e.touches.length !== 1) return;
            const dx = e.touches[0].clientX - startX;
            const sensitivity = getDragSensitivity();
            if (Math.abs(dx) >= sensitivity) {
                const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
                const steps = Math.floor(dx / sensitivity);
                state.angleIndex = (state.angleIndex + steps + total * 10) % total;
                startX = e.touches[0].clientX;
                drawCurrentFrame();
            }
        }, { passive: true });

        window.addEventListener("touchend", () => {
            isDragging = false;
        });

        window.addEventListener("touchcancel", () => {
            isDragging = false;
        });
    }

    function toggleAutoplay() {
        if (state.isAutoplaying) {
            stopAutoplay();
        } else {
            startAutoplay();
        }
    }

    function startAutoplay() {
        if (state.isAutoplaying) return;
        state.isAutoplaying = true;
        if (autoplayIcon) autoplayIcon.textContent = "⏸";
        if (autoplayText) autoplayText.textContent = "Pause";
        if (autoplayBtn) autoplayBtn.classList.add("active");
        if (rotateHint) rotateHint.style.opacity = "0";

        const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
        const intervalMs = total >= 72 ? 30 : 60; // 30% faster autoplay rotation

        state.autoplayInterval = setInterval(() => {
            const curTotal = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
            state.angleIndex = (state.angleIndex + 1) % curTotal;
            drawCurrentFrame();
        }, intervalMs);
    }

    function stopAutoplay() {
        if (!state.isAutoplaying) return;
        state.isAutoplaying = false;
        if (autoplayIcon) autoplayIcon.textContent = "▶";
        if (autoplayText) autoplayText.textContent = "Autoplay";
        if (autoplayBtn) autoplayBtn.classList.remove("active");
        if (state.autoplayInterval) {
            clearInterval(state.autoplayInterval);
            state.autoplayInterval = null;
        }
    }

    if (autoplayBtn) autoplayBtn.addEventListener("click", toggleAutoplay);

    if (resetBtn) {
        resetBtn.addEventListener("click", () => {
            stopAutoplay();
            state.angleIndex = 0;
            drawCurrentFrame();
        });
    }

    window.addEventListener("keydown", (e) => {
        if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
        const total = state.activeProduct ? (state.activeProduct.frameCount || CONFIG.defaultFrames) : CONFIG.defaultFrames;
        if (e.code === "Space") {
            e.preventDefault();
            toggleAutoplay();
        } else if (e.code === "ArrowLeft") {
            state.angleIndex = (state.angleIndex - 1 + total) % total;
            drawCurrentFrame();
        } else if (e.code === "ArrowRight") {
            state.angleIndex = (state.angleIndex + 1) % total;
            drawCurrentFrame();
        }
    });

    initCatalog();
</script>

<style is:global>
    /* ========================================================
       GLOBAL FIXES FOR ELARE 360 REVIEW HUB
       Tight spacing directly under navigation bar
       ======================================================== */

    .configurator-wrapper {
        display: grid !important;
        grid-template-columns: 320px 1fr !important;
        grid-template-rows: auto 1fr !important;
        align-items: start !important;
        padding-top: 0.25rem !important; /* Minimal gap below nav bar */
        padding-bottom: 2rem !important;
        row-gap: 8px !important;       /* Tight 8px gap between title and row 2 */
        column-gap: 28px !important;
        max-width: 1400px !important;
        margin: 0 auto !important;
    }

    /* Row 1: Title spanning across both columns */
    .config-description {
        display: block !important;
        grid-column: 1 / span 2 !important;
        grid-row: 1 !important;
        padding: 0 !important;
        margin: 0 auto !important;
        width: 100% !important;
        text-align: center !important;
    }

    .hub-title-wrapper {
        margin: 0 auto !important;
        padding: 0 !important;
        width: 100% !important;
        text-align: center !important;
    }

    .hub-main-title {
        font-size: 1.35rem !important;
        font-weight: 700 !important;
        letter-spacing: -0.01em !important;
        color: #fff !important;
        margin: 0 auto !important;
        padding: 0 !important;
        line-height: 1.1 !important;
        text-align: center !important;
    }

    /* Row 2: Sidebar (starts immediately 8px below title) */
    .controls-sidebar {
        grid-column: 1 !important;
        grid-row: 2 !important;
        width: 320px !important;
        min-width: 300px !important;
        max-width: 320px !important;
        margin-top: 0 !important;
        padding-top: 0 !important;
    }

    /* Row 2: Canvas (starts immediately 8px below title, perfectly aligned with sidebar) */
    .canvas-container {
        grid-column: 2 !important;
        grid-row: 2 !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: flex-start !important;
        justify-content: flex-start !important;
        width: 100% !important;
        margin-top: 0 !important;
        padding-top: 0 !important;
    }

    .turntable-stage {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: flex-start !important;
        width: 100% !important;
        max-width: 820px !important;
        margin-top: 0 !important;
        padding-top: 0 !important;
    }

    .canvas-wrapper {
        position: relative !important;
        width: 100% !important;
        max-width: 820px !important;
        aspect-ratio: 1 / 1 !important;
        background: radial-gradient(circle at center, #181818 0%, #050505 85%) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        border-radius: 12px !important;
        overflow: hidden !important;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25) !important;
        margin-top: 0 !important;
    }

    /* Centered Progress Indicator Underneath Canvas */
