---
import ConfiguratorLayout from "../../layouts/ConfiguratorLayout.astro";
---
<ConfiguratorLayout
    title="Microphone Configurator"
    description="Interactive 3D Microphone Configurator with Multipass Compositing"
    keywords="Microphone, Product Visualization, Configurator, WebGL, Canvas"    
    >
    <div id="rotate-hint">
        <span class="mouse-icon">🖱️</span>
        <span class="hint-text">Click & Drag to Rotate</span>
    </div>

    <Fragment slot="controls">
        <div class="control-body">
            
            <div class="control-section">
                <h4>Frame Color</h4>
                <div class="swatch-grid">
                    <button class="swatch selected" data-type="color" data-value="black" style="background: #111;" title="Black"></button>
                    <button class="swatch" data-type="color" data-value="white" style="background: #e0e0e0;" title="White"></button>
                </div>
            </div>

            <div class="control-section">
                <h4>Glow Light</h4>
                <div class="swatch-grid">
                    <button class="swatch" data-type="glow" data-value="off" style="background: linear-gradient(45deg, #ccc, #999); font-size: 9px;" title="Off">OFF</button>
                    <button class="swatch" data-type="glow" data-value="white" style="background: white; box-shadow: 0 0 5px white;" title="White Glow"></button>
                    <button class="swatch selected" data-type="glow" data-value="rainbow" style="background: linear-gradient(to right, red, orange, green, blue, violet);" title="Rainbow"></button>
                </div>
            </div>

			<div class="control-section">
				<h4>Camera Angle</h4>
				<div class="view-grid">
					<button class="view-btn active" data-view="rotation">360°</button>
					<button class="view-btn" data-view="hero-1">Hero 1</button>
					<button class="view-btn" data-view="hero-2">Hero 2</button>
					<button class="view-btn" data-view="detail-light">Light</button>
					<button class="view-btn" data-view="detail-mesh">Mesh</button>
					<button class="view-btn" data-view="detail-buttons">Buttons</button>
					<button class="view-btn" data-view="detail-logo">Logo</button>
				</div>
			</div>
        </div>
    </Fragment>


    <div class="canvas-wrapper">
        <canvas id="configCanvas" width="1200" height="1200"></canvas>
        <div id="loader">Loading...</div>
    </div>
	
	<div class="loader-container">
		<div class="progress-bar">
			<div id="progress-fill" style="width: 0%"></div>
		</div>
		<div id="progress-text">Loading Assets... 0/0</div>
	</div>
    <Fragment slot="config-description">
        <div class="content">
            <div class="row desc">
                <div class="col-1a">
                    <div class="post-desc">
                        <p>
                            Usually, 3D products are shown using static renders. But a static gallery makes it hard to show every possible material and lighting combination, so I built this interactive configurator instead.
                        </p>
                        <p>
                            It works by layering different images together on the fly. The base metal frame, the glowing meshes, and the lighting are all separate layers, organized by camera angle and material.
                        </p>
                        <p>
                            To keep it fast, I compressed all 420 render combinations into WebP files, keeping the total size under 14MB. The main images load instantly when you open the page, and the rest load quietly in the background so everything feels smooth and instant when you click around.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </Fragment>
</ConfiguratorLayout>


<style>
    #content{

    }
	/* Canvas & Layout */
    .canvas-wrapper {
        position: relative;
        
        /* 🔒 FORCE FIXED SIZE */
        width: 1200px;
        height: 1200px;
        margin: 0 auto;
        
        /* Remove responsive constraints */
        max-width: none; 
        aspect-ratio: auto; 

        /*background: radial-gradient(circle, #2a2a2a 0%, #111 70%);*/
        border-radius: 8px;
        overflow: hidden;
        cursor: grab;
    }
    
    .canvas-wrapper:active {
        cursor: grabbing;
    }

    canvas {
        /* 🔒 FORCE CANVAS TO FILL WRAPPER EXACTLY */
        width: 1200px;
        height: 1200px;
        display: block;
    }

    /* Hints */
    #rotate-hint {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(0,0,0,0.7);
        padding: 12px 24px;
        border-radius: 30px;
        color: white;
        pointer-events: none;
        transition: opacity 0.5s;
        z-index: 10;
        display: flex;
        gap: 10px;
        align-items: center;
    }
    #rotate-hint.fade-out { opacity: 0; }

    #loader {
        position: absolute;
        bottom: 10px;
        right: 10px;
        color: #666;
        font-size: 0.8rem;
        opacity: 0;
        transition: opacity 0.3s;
    }
    #loader.visible { opacity: 1; }

	/* Controls Styling */
    .control-body {
        padding: 20px 0;
    }

    .control-section {
        margin-bottom: 24px; /* Space between groups */
    }

    .control-section h4 {
        margin: 0 0 10px 0;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
    }

    /* Swatches */
    .swatch-grid { display: flex; gap: 12px; flex-wrap: wrap; }
    
    .swatch {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 2px solid #444;
        cursor: pointer;
        transition: transform 0.2s, border-color 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        color: #000;
        font-weight: bold;
    }
    
    .swatch:hover { transform: scale(1.1); }
    .swatch.selected { border-color: #fff; outline: 2px solid #007bff; transform: scale(1.1); }

	.view-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr); /* 3 columns */
        gap: 8px;
    }

    .view-btn {
        background: #222;
        border: 1px solid #444;
        color: #ccc;
        padding: 8px 4px;
        border-radius: 4px;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .view-btn:hover { background: #333; }
    
    .view-btn.active {
        background: #eee;
        color: #111;
        border-color: #fff;
        font-weight: bold;
    }

    /* Debug Toggles */
    .toggle-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    
    .toggle-row {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        color: #ccc;
        font-size: 0.9rem;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }
	canvas {
		/* THE ACES SIMULATION 
		1. brightness(2.0): Lifts the linear/raw darkness up to visible range.
		2. contrast(1.1): Adds that "filmic" punch.
		3. saturate(1.1): Linear composites often look desaturated; this fixes it.
		*/
		
		/* Ensure the canvas renders crisp edges */
		image-rendering: -webkit-optimize-contrast;
	}
	.loader-container {
        /* 🔒 Position absolutely at bottom of canvas wrapper */
        position: absolute;
        bottom: 30px; 
        left: 50%;
        transform: translateX(-50%);
        z-index: 20; /* Ensure it sits on top of the image */

        width: 60%; /* Make it 60% of the canvas width */
        max-width: 400px;
        text-align: center;
        background: rgba(0, 0, 0, 0.6); /* Optional: semi-transparent backing */
        padding: 10px 20px;
        border-radius: 20px;
        backdrop-filter: blur(5px); /* Nice glass effect */
        transition: opacity 0.5s;
    }

    .progress-bar {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.2); /* Darker track */
        border-radius: 3px;
        overflow: hidden;
        margin-bottom: 5px;
    }

    #progress-fill {
        height: 100%;
        background: #007bff;
        transition: width 0.2s;
    }

    #progress-text {
        font-size: 14px;
        color: #fff; /* White text for contrast */
        font-weight: 500;
    }
</style>

<script>
    // --- 1. CONFIGURATION & STATE ---

    const CONFIG = {
        basePath: "/assets/projects/mic/", // 🟢 Changed from specific 'rotation' path
        angles: 36,
        startFrame: 1001, 
    };

    // Define available views
    const VIEWS = {
        'rotation': { type: '360', folder: 'rotation', label: '360° View' },
        'hero-1':   { type: 'static', folder: 'hero-1', label: 'Hero 1' },
        'hero-2':   { type: 'static', folder: 'hero-2', label: 'Hero 2' },
        'detail-light':   { type: 'static', folder: 'detail-light', label: 'Light Detail' },
        'detail-mesh':    { type: 'static', folder: 'detail-mesh', label: 'Mesh Detail' },
        'detail-buttons': { type: 'static', folder: 'detail-buttons', label: 'Buttons' },
        'detail-logo':    { type: 'static', folder: 'detail-logo', label: 'Logo' },
    };

    const state = {
        view: 'rotation', // 🟢 New State: 'rotation', 'hero-1', etc.
        angle: 0,           
        frameColor: 'black',
        glow: 'rainbow',        
    };
    // 🟢 NEW: Auto-Spin Variables
    let autoSpinTimer = null;
    const SPIN_SPEED = 50; // ms per frame (increase to slow down)

    // 🟢 NEW: Auto-Spin Functions
    function startAutoSpin() {
        // Only spin if we are in 360 mode and not already spinning
        if (state.view !== 'rotation' || autoSpinTimer) return;
        
        autoSpinTimer = setInterval(() => {
            state.angle = (state.angle + 1) % CONFIG.angles;
            render();
        }, SPIN_SPEED);
    }

    function stopAutoSpin() {
        if (autoSpinTimer) {
            clearInterval(autoSpinTimer);
            autoSpinTimer = null;
        }
    }

	// 🔴 ADD THIS LINE HERE
    let rainbowAnimationId = null;

    // --- 2. ASSET MANAGEMENT ---

    const canvas = document.getElementById("configCanvas");
    const ctx = canvas.getContext("2d");
    const loaderUI = document.getElementById("loader");
    const imageCache = {};
    let pendingLoads = 0;

    /**
     * NEW FORMAT: {Color}_{GlowState}_{Frame}.webp
     * Example Base:   white_off_1001.webp
     * Example Glow:   white_rainbow_1001.webp
     */
	function getAssetPath(group, frameIndex) {
        // 1. Determine Folder & Config
        const currentViewConfig = VIEWS[state.view];
        const folder = currentViewConfig.folder;
        const isRotation = currentViewConfig.type === '360';
        
        // 2. Handle Glow Label
        const glowLabel = (group === 'normal') ? 'off' : state.glow;
        
        // 3. Construct Filename
        let fileName;
        
        if (isRotation) {
            // Rotation needs frame number: "black_off_1001"
            const fileNum = CONFIG.startFrame + frameIndex;
            fileName = `${state.frameColor}_${glowLabel}_${fileNum}`;
        } else {
            // Static shots have NO number: "black_off"
            // Note: If your static files are named "black_off_static" or similar, adjust here.
            // Assuming strictly: "black_off.webp"
            fileName = `${state.frameColor}_${glowLabel}`;
        }
        
        // 4. Return Full Path
        return `${CONFIG.basePath}${folder}/${group}/${fileName}.webp`;
    }
    function loadImage(url, callback) {
        if (imageCache[url]) {
            if (imageCache[url].complete) {
                callback(imageCache[url]);
            } else {
                imageCache[url].addEventListener('load', () => callback(imageCache[url]));
            }
            return;
        }

        const img = new Image();
        pendingLoads++;
        updateLoader();

        img.src = url;
        imageCache[url] = img;

        img.onload = () => {
            pendingLoads--;
            updateLoader();
            callback(img);
        };

        img.onerror = () => {
            console.warn("Missing image:", url);
            pendingLoads--;
            updateLoader();
        };
    }

    function updateLoader() {
        if(pendingLoads > 0) loaderUI.classList.add('visible');
        else loaderUI.classList.remove('visible');
    }

    // --- 3. RENDERING ENGINE ---

function render() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // --- LAYER 1: NORMAL ---
        ctx.filter = 'none'; 
        ctx.globalCompositeOperation = 'source-over';
        
        const urlNormal = getAssetPath('normal', state.angle);
        if (imageCache[urlNormal]?.complete) {
            ctx.drawImage(imageCache[urlNormal], 0, 0);
        } else {
            loadImage(urlNormal, () => {
                // Only re-render if we aren't currently animating
                // (If animating, the loop handles the re-render automatically)
                if (!rainbowAnimationId && !autoSpinTimer && getAssetPath('normal', state.angle) === urlNormal) render();
            });
        }

        // --- PREPARE RAINBOW FILTER (TIME BASED) ---
        if (state.glow === 'rainbow') {
            // Speed: Divide by larger number to slow down, smaller to speed up
            // performance.now() returns milliseconds since page load
            const speed = 0.15; 
            const hue = (performance.now() * speed) % 360; 
            ctx.filter = `hue-rotate(${hue}deg)`;
        } else {
            ctx.filter = 'none';
        }

        // --- LAYER 2: GLOW MESH ---
        if (state.glow !== 'off') {
            const urlMesh = getAssetPath('glowMesh', state.angle);
            ctx.globalCompositeOperation = 'source-over'; 
            if (imageCache[urlMesh]?.complete) ctx.drawImage(imageCache[urlMesh], 0, 0);
            else loadImage(urlMesh, () => { if(!rainbowAnimationId && !autoSpinTimer) render(); });
        }

        // --- LAYER 3: GLOW LIGHT ---
        if (state.glow !== 'off') {
            const urlLight = getAssetPath('glowLight', state.angle);
            ctx.globalCompositeOperation = 'screen'; 
            if (imageCache[urlLight]?.complete) ctx.drawImage(imageCache[urlLight], 0, 0);
            else loadImage(urlLight, () => { if(!rainbowAnimationId && !autoSpinTimer) render(); });
        }

        // Reset
        ctx.filter = 'none';
        
        // --- ANIMATION LOOP ---
        // Clear any existing animation frame to prevent "doubling" speed
        if (rainbowAnimationId) {
            cancelAnimationFrame(rainbowAnimationId);
            rainbowAnimationId = null;
        }

        // If rainbow is active, request the next frame immediately
        if (state.glow === 'rainbow') {
            rainbowAnimationId = requestAnimationFrame(render);
        }
    }

    // --- 4. INTERACTION HANDLERS ---

    // B. Color/Glow Swatches
    document.querySelectorAll('.swatch').forEach(btn => {
        btn.addEventListener('click', () => {
            const type = btn.dataset.type;
            const value = btn.dataset.value;

            if(type === 'color') state.frameColor = value;
            if(type === 'glow') {
                state.glow = value;
                // Stop animation if switching AWAY from rainbow
                if (value !== 'rainbow' && rainbowAnimationId) {
                    cancelAnimationFrame(rainbowAnimationId);
                    rainbowAnimationId = null;
                }
            }

            btn.parentElement.querySelectorAll('.swatch').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');

            render();
            
            // Optional: Re-sort preload queue here if you want super-optimization
        });
    });

    // C. Drag Rotation
    let isDragging = false;
    let startX = 0;
    const hint = document.getElementById('rotate-hint');

	function handleDragStart(x) {
        // 🔒 LOCK: Only allow drag if in 360 mode
        if (VIEWS[state.view].type !== '360') return;
        stopAutoSpin();
        isDragging = true;
        startX = x;
        if(hint) hint.classList.add('fade-out');
    }

    function handleDragMove(x) {
        if (!isDragging) return;
        const dx = x - startX;
        const sensitivity = 15; 

        if (Math.abs(dx) >= sensitivity) {
            const direction = Math.sign(-dx); 
            state.angle = (state.angle - direction + CONFIG.angles) % CONFIG.angles;
            startX = x;
            render();
        }
    }
	// D. View Switching
    document.querySelectorAll('.view-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            // Update State
            state.view = btn.dataset.view;

            // UI Update
            document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            // Show/Hide Rotation Hint
            const hint = document.getElementById('rotate-hint');
            if(state.view === 'rotation') {
                if(hint) hint.style.display = 'flex';
                canvas.style.cursor = 'grab';
            } else {
                if(hint) hint.style.display = 'none';
                canvas.style.cursor = 'default';
            }

            render();
        });
    });

    canvas.addEventListener('mousedown', e => handleDragStart(e.clientX));
    window.addEventListener('mousemove', e => handleDragMove(e.clientX));
    window.addEventListener('mouseup', () => isDragging = false);

    canvas.addEventListener('touchstart', e => {
        handleDragStart(e.touches[0].clientX);
        e.preventDefault(); 
    }, {passive: false});
    window.addEventListener('touchmove', e => handleDragMove(e.touches[0].clientX));
    window.addEventListener('touchend', () => isDragging = false);

    // --- 5. SMART PRELOADER ---

    const PRELOAD_CONFIG = {
        colors: ['black', 'white'], 
        glows: ['white', 'rainbow'],
    };

    // 🟢 THIS WAS MISSING IN YOUR PREVIOUS CODE
    let fullAssetList = [];
    let loadedCount = 0;

	function generateAssetList() {
        const list = [];

        // 1. Iterate through every view (rotation, hero-1, detail-buttons, etc.)
        Object.values(VIEWS).forEach(view => {
            const isRotation = view.type === '360';
            const folder = view.folder;
            const pathPrefix = `${CONFIG.basePath}${folder}`;

            // 2. Iterate through every Color
            PRELOAD_CONFIG.colors.forEach(color => {
                
                // If it's a rotation, we loop 36 times. If static, just once.
                const loopCount = isRotation ? CONFIG.angles : 1;

                for (let i = 0; i < loopCount; i++) {
                    
                    // 3. Construct the Filename Suffix
                    // Rotation: "_1001"
                    // Static:   "" (empty string)
                    let suffix = '';
                    if (isRotation) {
                        const fileNum = CONFIG.startFrame + i;
                        suffix = `_${fileNum}`;
                    }

                    // A. Normal Layer (Always "off")
                    // Result: "black_off_1001" OR "black_off"
                    const normalName = `${color}_off${suffix}`;
                    list.push({ url: `${pathPrefix}/normal/${normalName}.webp`, priority: isRotation ? 2 : 1 });

                    // B. Glow Layers
                    // Result: "black_rainbow_1001" OR "black_rainbow"
                    PRELOAD_CONFIG.glows.forEach(glow => {
                        const glowName = `${color}_${glow}${suffix}`;
                        list.push({ url: `${pathPrefix}/glowMesh/${glowName}.webp`, priority: 3 });
                        list.push({ url: `${pathPrefix}/glowLight/${glowName}.webp`, priority: 3 });
                    });
                }
            });
        });
        
        return list;
    }

    function startBackgroundPreload() {
        fullAssetList = generateAssetList();

        // Sort: Current color first
        fullAssetList.sort((a, b) => {
            const isCurrentColorA = a.url.includes(state.frameColor);
            const isCurrentColorB = b.url.includes(state.frameColor);
            return isCurrentColorB - isCurrentColorA; 
        });

        const total = fullAssetList.length;
        const progressFill = document.getElementById('progress-fill');
        const progressText = document.getElementById('progress-text');
        const container = document.querySelector('.loader-container');

        function loadNext() {
            if (fullAssetList.length === 0) {
                if(progressText) progressText.innerText = "All Assets Ready";
                if(progressFill) progressFill.style.background = "#2ecc71";
                if(container) setTimeout(() => { container.style.opacity = 0; }, 2000);
                return;
            }

            const item = fullAssetList.shift(); 

            if (imageCache[item.url]) {
                loadedCount++;
                updateUI();
                loadNext(); 
            } else {
                const img = new Image();
                img.src = item.url;
                img.onload = () => {
                    imageCache[item.url] = img;
                    loadedCount++;
                    updateUI();
                    loadNext(); 
                };
                img.onerror = () => {
                    console.warn("Failed:", item.url);
                    loadedCount++; // Count it anyway to keep progress moving
                    updateUI();
                    loadNext(); 
                };
            }
        }

        function updateUI() {
            if(!progressFill || !progressText) return;
            const pct = Math.round((loadedCount / total) * 100);
            progressFill.style.width = `${pct}%`;
            progressText.innerText = `Caching assets... ${loadedCount} / ${total}`;
        }

        // Start 4 concurrent loaders
        loadNext(); loadNext(); loadNext(); loadNext();
    }

    // --- 6. INITIALIZATION ---
    render();

    setTimeout(() => {
		render();
        startBackgroundPreload();
    }, 1000);

</script>