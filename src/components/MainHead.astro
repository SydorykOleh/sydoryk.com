---
import Analytics from '../components/functions/Analytics.astro';
import '../styles/layout.scss';
import '../styles/global.scss';
interface Props {
	title?: string | undefined;
	description?: string | undefined;
	keywords?: string | undefined;
}
const { title, description,keywords } = Astro.props;
---

<meta charset="UTF-8" />
<meta name="description" property="og:description" content={description} />
<meta name="keywords" content={keywords} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={title} href={new URL("rss.xml", Astro.site)} />

<meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
<script is:inline>
    const getThemePreference = () => {
        return 'dark'; // Force return dark regardless of settings
    };
    
    const isDark = true; // Always true
    document.documentElement.classList.add('theme-dark');

    // You can delete the MutationObserver section entirely as well
</script>

<Analytics />